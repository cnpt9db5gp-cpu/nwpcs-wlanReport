def detect_distro():
    try:
        ids = {}
        for line in pathlib.Path("/etc/os-release").read_text().splitlines():
            if "=" in line:
                k, v = line.split("=", 1)
                ids[k] = v.strip().strip('"').lower()
        return ids.get("ID", ""), ids.get("ID_LIKE", "")
    except Exception:  # noqa: BLE001
        return "", ""


def _pkg_for(distro, like, pkgs):
    for fam in [distro] + like.split() + ["debian"]:
        if fam == "arch":
            return pkgs["arch"], "sudo pacman -S"
        if fam in ("debian", "ubuntu", "linuxmint", "pop", "raspbian", "kali"):
            return pkgs["debian"], "sudo apt install"
        if fam in ("fedora", "rhel", "centos", "almalinux", "rocky", "opensuse"):
            return pkgs["fedora"], "sudo dnf install"
    return pkgs["debian"], "sudo apt install"


def wireless_ifaces():
    found = []
    try:
        for p in pathlib.Path("/sys/class/net").iterdir():
            if (p / "wireless").exists():
                found.append(p.name)
    except Exception:  # noqa: BLE001
        pass
    return sorted(found)


def check_capabilities(iface=None):
    """Probe tools + permissions. Returns list of dicts: name/ok/level/detail/hint.

    level is 'required' or 'optional'. ok is True/False.
    """
    checks = []
    distro, like = detect_distro()
    for binary, purpose, pkgs, required in DEPS:
        if shutil.which(binary):
            checks.append({"name": binary, "ok": True, "level": "required" if required else "optional",
                           "detail": purpose, "hint": ""})
        else:
            pkg, mgr = _pkg_for(distro, like, pkgs)
            flag = "" if required else " (optional — related report sections will be skipped)"
            checks.append({"name": binary, "ok": False, "level": "required" if required else "optional",
                           "detail": "MISSING — " + purpose,
                           "hint": f"install: {mgr} {pkg}{flag}"})
    if shutil.which("nmcli"):
        _, code = run(["nmcli", "general", "status"], timeout=10)
        if code == 0:
            checks.append({"name": "NetworkManager", "ok": True, "level": "required",
                           "detail": "service is running", "hint": ""})
        else:
            checks.append({"name": "NetworkManager", "ok": False, "level": "required",
                           "detail": "nmcli cannot reach NetworkManager",
                           "hint": "start it: sudo systemctl enable --now NetworkManager"})
    wifis = wireless_ifaces()
    if wifis:
        checks.append({"name": "wifi-iface", "ok": True, "level": "required",
                       "detail": "wireless interface(s): " + ", ".join(wifis), "hint": ""})
    else:
        checks.append({"name": "wifi-iface", "ok": False, "level": "required",
                       "detail": "no wireless interface found",
                       "hint": "no Wi-Fi hardware/driver? check: lspci -k | grep -i network"})
    if shutil.which("journalctl"):
        out, code = run(["journalctl", "-u", "NetworkManager", "--since", "5 min ago",
                         "--no-pager", "-n", "1"], timeout=15)
        low = out.lower()
        if code == 0 and "access denied" not in low and "no journal" not in low:
            checks.append({"name": "journal", "ok": True, "level": "optional",
                           "detail": "can read NetworkManager history", "hint": ""})
        else:
            checks.append({"name": "journal", "ok": False, "level": "optional",
                           "detail": "cannot read system journal — event-log section will note this",
                           "hint": "fix: sudo usermod -aG systemd-journal $USER (then re-login), "
                                   "or run with sudo"})
    if iface and iface not in wifis:
        checks.append({"name": "iface:" + iface, "ok": False, "level": "required",
                       "detail": f"interface '{iface}' is not a wireless interface",
                       "hint": f"available: {', '.join(wifis) if wifis else '(none)'} — omit --iface to auto-detect"})
    return checks


def print_check_report(checks, use_color=True):
    def paint(color, text):
        return (_ANSI.get(color, "") + text + _ANSI["reset"]) if use_color else text

    print(f"{'CHECK':16} {'STATUS':9} DETAIL / FIX")
    print("-" * 70)
    failed_required = 0
    for c in checks:
        if c["ok"]:
            status = paint("green", "OK     ")
        elif c["level"] == "required":
            status = paint("red", "MISSING")
            failed_required += 1
        else:
            status = paint("yellow", "LIMITED")
        print(f"{c['name']:16} {status} {c['detail']}")
        if c["hint"]:
            print(f"{'':16} {'':9} -> {paint('dim', c['hint']) if use_color else c['hint']}")
    print("-" * 70)
    if failed_required:
        print(paint("red", f"{failed_required} required check(s) failed — fix them, then re-run."))
    else:
        print(paint("green", "ready — all required checks passed."))
        limited = [c for c in checks if not c["ok"]]
        if limited:
            print(paint("yellow", "note: some optional checks are LIMITED; those report sections degrade gracefully."))
    return 1 if failed_required else 0

# ---------------------------------------------------------------- utils

def run(cmd, timeout=25):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        out = (r.stdout or "")
        if r.stderr:
            out += ("\n[stderr]\n" + r.stderr if out else r.stderr)
        return out.strip(), r.returncode
    except FileNotFoundError:
        return f"[missing: {cmd[0]}]", 127
    except subprocess.TimeoutExpired:
        return "[timeout]", 124
    except Exception as e:  # noqa: BLE001
        return f"[error: {e}]", 1


def detect_iface(hint=None):
    if hint:
        return hint
    out, _ = run(["nmcli", "-t", "-f", "DEVICE,TYPE,STATE", "device", "status"], timeout=10)
    wifi = []
    for line in out.splitlines():
        parts = line.strip().split(":")
        if len(parts) >= 3 and parts[1] == "wifi":
            wifi.append((parts[0], parts[2]))
    for dev, state in wifi:  # prefer connected wifi
        if state == "connected":
            return dev
    if wifi:
        return wifi[0][0]
    # fallback: first wireless iface from /sys
    try:
        for p in pathlib.Path("/sys/class/net").iterdir():
            if (p / "wireless").exists():
                return p.name
    except Exception:  # noqa: BLE001
        pass
    return "wlo1"


def parse_terse(line, nfields):
    """Split nmcli --terse line on unescaped ':' (nmcli escapes ':' as '\\:')."""
    PH = "\x00"
    tmp = line.replace("\\:", PH).replace("\\\\", "\\")
    parts = [p.replace(PH, ":") for p in tmp.split(":")]
    if len(parts) < nfields:
        parts += [""] * (nfields - len(parts))
    elif len(parts) > nfields:
        surplus = len(parts) - nfields
        parts = [parts[0]] + [":".join(parts[1:2 + surplus])] + parts[2 + surplus:]
    return parts


def signal_to_dbm(sig_pct):
    try:
        return int(round(int(sig_pct) / 2 - 100))
    except Exception:  # noqa: BLE001
        return None


def quality_label(sig):
    try:
        s = int(sig)
    except Exception:  # noqa: BLE001
        return "Unknown"
    if s >= 80:
        return "Excellent"
    if s >= 65:
        return "Very good"
    if s >= 50:
        return "Good"
    if s >= 35:
        return "Fair"
    if s >= 20:
        return "Weak"
    return "Very weak"


def sec_label(s):
    s = (s or "").upper()
    if "WPA3" in s and "WPA2" in s:
        return "WPA2/WPA3 transitional"
    if "WPA3" in s:
        return "WPA3"
    if "WPA2" in s and "WPA1" in s:
        return "WPA1/WPA2 (legacy TKIP!)"
    if "WPA2" in s:
        return "WPA2"
    if "WPA1" in s:
        return "WPA1 (weak)"
    if "WEP" in s:
        return "WEP (insecure!)"
    if s.strip() in ("", "--", "NONE"):
        return "Open (no security!)"
    return s or "Unknown"


# ------------------------------------------------------------ collectors

def get_wifi_networks(iface, rescan=True, log=None):
    if shutil.which("nmcli") is None:
        if log:
            log.say("err", "nmcli not found — cannot scan. install NetworkManager, then re-run.")
        return []
    if rescan:
        if log:
            log.step("rescan", f"rescanning nearby networks on {iface}")
        run(["nmcli", "device", "wifi", "rescan", "ifname", iface], timeout=15)
        time.sleep(2)
        if log:
            log.done("rescan", "scan finished")
    fields = ["IN-USE", "SSID", "BSSID", "MODE", "CHAN", "FREQ", "RATE", "SIGNAL", "BARS", "SECURITY"]
    flag = "yes" if rescan else "no"
    out, _ = run(["nmcli", "-t", "-f", ",".join(fields), "device", "wifi",
                  "list", "ifname", iface, "--rescan", flag], timeout=30)
    nets = []
    for line in out.splitlines():
        line = line.strip()
        if not line or line.startswith("Error") or "no networks" in line.lower():
            continue
        d = dict(zip(fields, parse_terse(line, len(fields))))
        try:
            d["SIGNAL_INT"] = int(d["SIGNAL"]) if d["SIGNAL"].strip().isdigit() else -1
        except Exception:  # noqa: BLE001
            d["SIGNAL_INT"] = -1
        d["SSID_DISP"] = d["SSID"] if d["SSID"] else "(hidden SSID)"
        nets.append(d)
    # band / bandwidth detail
    df = ["SSID", "BSSID", "MODE", "CHAN", "BAND", "FREQ", "RATE", "BANDWIDTH", "SIGNAL", "SECURITY"]
    out2, _ = run(["nmcli", "-t", "-f", ",".join(df), "device", "wifi",
                   "list", "ifname", iface, "--rescan", "no"], timeout=20)
    det = {}
    for line in out2.splitlines():
        line = line.strip()
        if not line:
            continue
        dd = dict(zip(df, parse_terse(line, len(df))))
        det[(dd["SSID"], dd["BSSID"])] = dd
    for n in nets:
        dd = det.get((n["SSID"], n["BSSID"]), {})
        n["BAND"] = dd.get("BAND", "")
        n["BANDWIDTH"] = dd.get("BANDWIDTH", "")
        m = re.search(r"(\d+)", n.get("FREQ", ""))
        n["FREQ_MHZ"] = int(m.group(1)) if m else 0
        if not n["BAND"]:
            f = n["FREQ_MHZ"]
            if 2400 <= f < 2500:
                n["BAND"] = "2.4 GHz"
            elif 5000 <= f < 5900:
                n["BAND"] = "5 GHz"
            elif f >= 5900:
                n["BAND"] = "6 GHz"
        n["IFACE"] = iface
    nets.sort(key=lambda x: x["SIGNAL_INT"], reverse=True)
    if log:
        top = f"top: {nets[0]['SSID_DISP']} ({nets[0]['SIGNAL_INT']}%)" if nets else "none found"
        log.say("wlan", f"found {len(nets)} network(s) — {top}")
    return nets


def kv_parse(text):
    d = {}
    for line in text.splitlines():
        if ":" in line:
            k, v = line.split(":", 1)
            d[k.strip()] = v.strip()
    return d


def parse_ping(txt):
    m = re.search(r"(\d+) packets transmitted,\s*(\d+) received.*?(\d+)% packet loss"
                  r".*?rtt min/avg/max/mdev =\s*([\d.]+)/([\d.]+)/([\d.]+)/([\d.]+)", txt, re.S)
    if m:
        return {"tx": m.group(1), "rx": m.group(2), "loss": m.group(3) + "%",
                "min": m.group(4), "avg": m.group(5), "max": m.group(6), "mdev": m.group(7)}
    m2 = re.search(r"(\d+)% packet loss", txt)
    return {"tx": "?", "rx": "?", "loss": (m2.group(0) if m2 else "?"),
            "min": "-", "avg": "-", "max": "-", "mdev": "-"}


def collect_all(iface, rescan=True, do_ping=True, log_minutes=60, log=None):
    def _step(k, m):
        if log:
            log.step(k, m)

    def _done(k, m=""):
        if log:
            log.done(k, m)

    _step("adapter", "reading adapter + link state")
    general, _ = run(["nmcli", "general", "status"])
    dev_status, _ = run(["nmcli", "device", "status"])
    dev_show_txt, _ = run(["nmcli", "-f", "GENERAL,IP4,IP6,DHCP4", "device", "show", iface])
    dev_kv = kv_parse(dev_show_txt)
    iw_link, _ = run(["iw", "dev", iface, "link"])
    iw_station, _ = run(["iw", "dev", iface, "station", "dump"])
    lspci, _ = run(["lspci", "-k"])
    proc_wireless, _ = run(["cat", "/proc/net/wireless"])
    if log:
        if iw_link.startswith("[missing:"):
            log.say("warn", "iw not found — link rate/signal falls back to estimates (install package 'iw')")
        elif "Not connected" in iw_link:
            log.say("warn", f"{iface} is not associated to any AP — Wi-Fi may be disconnected")
    _done("adapter", "adapter + link state collected")

    _step("nets", "scanning nearby networks")
    nets = get_wifi_networks(iface, rescan=rescan, log=log)
    _done("nets", f"{len(nets)} network(s) in range")

    _step("net", "checking IP, routes + DNS")
    ip_route, _ = run(["ip", "route", "show"])
    ip6_route, _ = run(["ip", "-6", "route", "show"])
    dns_conf, _ = run(["cat", "/etc/resolv.conf"])
    resolvectl, _ = run(["resolvectl", "status", iface])
    conn_active, _ = run(["nmcli", "-t", "-f", "NAME,UUID,TYPE,DEVICE",
                           "connection", "show", "--active"])
    _done("net", "IP + DNS collected")

    gw = dev_kv.get("IP4.GATEWAY", "192.168.1.1")
    if do_ping:
        _step("ping", f"pinging gateway {gw}, 8.8.8.8 + google.com (5 pkts each)")
        ping_gw, _ = run(["ping", "-c", "5", "-W", "2", gw])
        ping_ext, _ = run(["ping", "-c", "5", "-W", "2", "8.8.8.8"])
        ping_dns, _ = run(["ping", "-c", "5", "-W", "2", "google.com"])
        _done("ping", "latency probes finished")
    else:
        if log:
            log.say("sys", "ping tests skipped (--no-ping)")
        ping_gw = ping_ext = ping_dns = "ping skipped (--no-ping)"

    _step("logs", f"reading NetworkManager journal (last {log_minutes} min)")
    nm_logs, _ = run(["journalctl", "-u", "NetworkManager", "--since",
                       f"{log_minutes} min ago", "--no-pager", "-o", "short-iso"], timeout=20)
    low = nm_logs.lower()
    if "access denied" in low or "no journal" in low or "permission denied" in low:
        nm_logs = ("[unavailable] cannot read the system journal from this user — "
                   "the event-log section is skipped.\n"
                   "Fix: sudo usermod -aG systemd-journal $USER (then re-login), or re-run with sudo.")
        if log:
            log.say("warn", "journal unreadable (permissions) — event-log section will note this, continuing.")
        _done("logs", "journal unavailable (permissions), skipped gracefully")
    else:
        _done("logs", "event history collected")
    return {
        "iface": iface, "general": general, "dev_status": dev_status,
        "dev_kv": dev_kv, "dev_show_txt": dev_show_txt,
        "iw_link": iw_link, "iw_station": iw_station,
        "ip_route": ip_route, "ip6_route": ip6_route,
        "dns_conf": dns_conf, "resolvectl": resolvectl, "lspci": lspci,
        "proc_wireless": proc_wireless, "nm_logs": nm_logs,
        "conn_active": conn_active, "nets": nets,
        "ping_gw_txt": ping_gw, "ping_ext_txt": ping_ext, "ping_dns_txt": ping_dns,
        "ping_gw": parse_ping(ping_gw), "ping_ext": parse_ping(ping_ext),
        "ping_dns": parse_ping(ping_dns), "gw": gw,
    }


def build_recommendations(data, cur, cur_dbm):
    recs = []
    esc = html.escape
    nets = data["nets"]
    pg, pe = data["ping_gw"], data["ping_ext"]
    if cur_dbm is not None:
        if cur_dbm >= -50:
            recs.append(("good", f"Signal is excellent ({cur_dbm} dBm). No action needed."))
        elif cur_dbm >= -65:
            recs.append(("good", f"Signal is good ({cur_dbm} dBm) — suitable for HD video calls and gaming."))
        elif cur_dbm >= -72:
            recs.append(("warn", f"Signal is fair ({cur_dbm} dBm). Move closer to the AP or pick a stronger BSSID of the same SSID."))
        else:
            recs.append(("bad", f"Signal is weak ({cur_dbm} dBm). Move closer, switch band, or add a mesh node."))
    if cur is not None:
        same_ch = [n for n in nets if n["CHAN"] == cur["CHAN"]]
        if len(same_ch) >= 4:
            names = ", ".join(esc(x["SSID_DISP"]) for x in same_ch[:4])
            recs.append(("warn", f"Channel {esc(cur['CHAN'])} is congested ({len(same_ch)} APs share it, incl. {names}). "
                                 "If you control the router, try a cleaner 5 GHz channel (44, 52, 100, 149+) with 40/80 MHz width."))
        elif len(same_ch) >= 2:
            recs.append(("info", f"Channel {esc(cur['CHAN'])} is shared by {len(same_ch)} APs — normal in apartments. "
                                 "160 MHz width is fast but picks up more interference; drop to 80 MHz if latency spikes."))
    groups = collections.Counter(n["SSID"] for n in nets)
    dupes = [s for s, c in groups.items() if c > 1 and s]
    if dupes:
        recs.append(("info", "Multiple BSSIDs broadcast the same SSID (%s) — a mesh / multi-AP setup. "
                             "The client roams to the best BSSID automatically."
                     % ", ".join(esc(s) if s else "(hidden)" for s in dupes[:5])))
    weak = [n for n in nets if "WPA1" in (n["SECURITY"] or "") or "WEP" in (n["SECURITY"] or "")]
    if weak:
        recs.append(("warn", f"{len(weak)} nearby network(s) still use WPA1/TKIP or WEP "
                             f"({', '.join(esc(n['SSID_DISP']) for n in weak[:4])}). Avoid joining them; "
                             f"TKIP is broken and slows the 2.4 GHz band. Current: {esc(cur['SECURITY']) if cur else '?'}."))
    if cur is not None and "2.4" in (cur.get("BAND") or ""):
        recs.append(("info", "You're on 2.4 GHz (longer range, slower, crowded). For speed, prefer the _5G / _5GHz 5 GHz BSSID in the same room."))
    elif cur is not None and cur.get("BAND") == "5 GHz":
        recs.append(("good", "You're on 5 GHz with wide channel and HE (Wi-Fi 6) rates — best for throughput in the same room."))
    if pg.get("loss") not in ("0%",):
        recs.append(("bad", f"Packet loss to gateway ({esc(pg.get('loss', '?'))}) — check AP load or backhaul."))
    else:
        try:
            avg = float(pg.get("avg", "0") or 0)
        except ValueError:
            avg = 0
        if avg > 20:
            recs.append(("warn", f"Gateway latency is high (avg {esc(pg['avg'])} ms). Try a closer AP or 5 GHz."))
        else:
            recs.append(("good", f"Gateway latency healthy (avg {esc(pg['avg'])} ms, 0% loss); internet {esc(pe['avg'])} ms to 8.8.8.8."))
    hidden = [n for n in nets if not n["SSID"]]
    if hidden:
        recs.append(("info", f"{len(hidden)} hidden-SSID AP(s) detected (e.g. {esc(hidden[0]['BSSID'])} on ch {esc(hidden[0]['CHAN'])}). They still use airtime."))
    if data["dev_kv"].get("IP4.ADDRESS[1]", "").startswith("169.254."):
        recs.append(("bad", "APIPA address (169.254.x.x) — DHCP failed. Restart AP / renew lease."))
    return recs


# ------------------------------------------------------------ HTML report

def render_html(data, log_minutes=60):
    esc = html.escape
    nets = data["nets"]
    dev_kv = data["dev_kv"]
    iface = data["iface"]
    iw_link = data["iw_link"]
    now_local = datetime.datetime.now().astimezone()
    now_utc = datetime.datetime.now(datetime.timezone.utc)
    hostname = socket.gethostname()

    cur = next((n for n in nets if n.get("IN-USE") == "*"), None)
    m_ssid = re.search(r"SSID:\s*(.+)", iw_link)
    m_sig = re.search(r"signal:\s*(-?\d+)\s*dBm", iw_link)
    m_freq = re.search(r"freq:\s*([\d.]+)", iw_link)
    m_rx = re.search(r"rx bitrate:\s*([^\n]+)", iw_link)
    m_tx = re.search(r"tx bitrate:\s*([^\n]+)", iw_link)
    m_bss = re.search(r"Connected to\s*([0-9a-f:]+)", iw_link)
    cur_dbm = int(m_sig.group(1)) if m_sig else (signal_to_dbm(cur["SIGNAL_INT"]) if cur else None)

    chan_counts = collections.Counter(n["CHAN"] for n in nets if n["CHAN"])
    band_counts = collections.Counter(n["BAND"] or "Unknown" for n in nets)
    sec_counts = collections.Counter(sec_label(n["SECURITY"]) for n in nets)
    recs = build_recommendations(data, cur, cur_dbm)
    pg, pe, pd = data["ping_gw"], data["ping_ext"], data["ping_dns"]
    max_chan = max(chan_counts.values()) if chan_counts else 1
    try:
        local_ip = dev_kv.get("IP4.ADDRESS[1]", "-").split("/")[0]
    except Exception:  # noqa: BLE001
        local_ip = "-"
    cur_ssid = esc(m_ssid.group(1).strip() if m_ssid else (cur["SSID"] if cur else "-"))
    cur_bssid = esc(m_bss.group(1) if m_bss else (cur["BSSID"] if cur else "-"))
    radio_out, _ = run(["nmcli", "radio", "wifi"])
    radio = radio_out.splitlines()[0] if radio_out else ""
    lspci_line = next((l.strip() for l in data["lspci"].splitlines()
                       if "Network" in l or "Wireless" in l or "WiFi" in l), "-")
    band_summary = ", ".join(f"{k}: {v}" for k, v in band_counts.items())

    rows = []
    for n in nets:
        sig = n["SIGNAL_INT"]
        cls = "cur" if n.get("IN-USE") == "*" else ""
        bar_w = max(0, min(100, sig))
        color = "#16a34a" if sig >= 65 else ("#ca8a04" if sig >= 45 else ("#ea580c" if sig >= 25 else "#dc2626"))
        dbm = signal_to_dbm(sig)
        star = "★" if n.get("IN-USE") == "*" else ""
        rows.append(
            f'<tr class="{cls}"><td>{star}</td>'
            f'<td><strong>{esc(n["SSID_DISP"])}</strong><div class="muted mono">{esc(n["BSSID"])}</div></td>'
            f'<td class="mono">{esc(n["CHAN"])}</td>'
            f'<td class="mono">{esc(n["FREQ"])}<div class="muted">{esc(n["BAND"])} · {esc(n["BANDWIDTH"])}</div></td>'
            f'<td><div class="sig"><div class="sigfill" style="width:{bar_w}%;background:{color}"></div></div>'
            f'<span class="mono">{sig}% · ~{dbm} dBm</span><div class="muted">{quality_label(sig)}</div></td>'
            f'<td class="mono">{esc(n["RATE"])}</td>'
            f'<td>{esc(sec_label(n["SECURITY"]))}<div class="muted mono">{esc(n["SECURITY"])}</div></td>'
            f'<td class="muted">{esc(n["MODE"])}</td></tr>')
    rows_html = "".join(rows)
    chan_bars_html = "".join(
        f'<div class="hrow"><span class="mono ch">ch {esc(ch)}</span>'
        f'<div class="hbar"><div class="hfill" style="width:{c / max_chan * 100:.0f}%"></div></div>'
        f'<span class="mono">{c} AP(s)</span></div>'
        for ch, c in sorted(chan_counts.items(),
                            key=lambda x: (int(x[0]) if str(x[0]).isdigit() else 9999)))
    sig_bars_html = "".join(
        f'<div class="hrow"><span class="ssid">{esc(n["SSID_DISP"])} '
        f'<span class="muted mono">{esc(n["BSSID"][-5:])} ch{esc(n["CHAN"])}</span></span>'
        f'<div class="hbar"><div class="hfill sigfill2" style="width:{max(0, min(100, n["SIGNAL_INT"]))}%"></div></div>'
        f'<span class="mono">{n["SIGNAL_INT"]}%</span></div>'
        for n in nets[:12])
    sec_rows_html = "".join(f"<tr><td>{esc(k)}</td><td class='mono'>{v}</td></tr>" for k, v in sec_counts.most_common())
    band_rows_html = "".join(f"<tr><td>{esc(k)}</td><td class='mono'>{v}</td></tr>" for k, v in band_counts.most_common())
    rec_html = "".join(f"<li class='{lvl}'><span class='badge'>{lvl.upper()}</span> {msg}</li>" for lvl, msg in recs)
    log_lines = data["nm_logs"].splitlines()[-80:]
    log_html = "\n".join(esc(line) for line in log_lines) if log_lines else "(no logs)"
    sig_pct = cur["SIGNAL_INT"] if cur else "?"
    sig_qual = quality_label(cur["SIGNAL_INT"]) if cur else ""
    rx_rate = m_rx.group(1).strip() if m_rx else (cur["RATE"] if cur else "-")
    tx_rate = m_tx.group(1).strip() if m_tx else ""
    freq_line = (m_freq.group(1) + " MHz") if m_freq else (cur["FREQ"] if cur else "-")
    cur_chan = cur["CHAN"] if cur else "?"
    cur_bandline = (cur["FREQ"] + " · " + cur["BAND"] + " · " + cur["BANDWIDTH"]) if cur else ""
    cur_sec = sec_label(cur["SECURITY"]) if cur else "-"
    cur_sec_raw = cur["SECURITY"] if cur else ""
    gen_state = dev_kv.get("GENERAL.STATE", "")
    product = dev_kv.get("GENERAL.PRODUCT", "Intel WiFi")
    driver = dev_kv.get("GENERAL.DRIVER", "")
    fw = dev_kv.get("GENERAL.FIRMWARE-VERSION", "")

    chat_entries = data.get("chat", []) or []
    if chat_entries:
        bubbles = []
        for e in chat_entries[-60:]:
            who = e.get("role", "wlan")
            mine = " me" if who == "you" else ""
            bubbles.append(
                f'<div class="bubble{mine}"><span class="who">{esc(who)} · {esc(e.get("t", ""))}</span>'
                f'{esc(e.get("text", ""))}</div>')
        chat_html = "".join(bubbles)
    else:
        chat_html = ('<div class="muted">No session log recorded — generate with '
                     '<code>wlan-report report</code> to see the progress + interaction here.</div>')

    return f"""<!DOCTYPE html>
