# Signal radiating from an access point, one frame per step (pure ASCII).
INTRO_FRAMES = [
    "\n\n\n           .\n         __|__",
    "\n\n         \\ | /\n           .\n         __|__",
    "\n        \\  |  /\n         \\ | /\n           .\n         __|__",
    "       \\   |   /\n        \\  |  /\n         \\ | /\n           .\n         __|__",
]
INTRO_DELAY = 0.09


def _supports_animation(stream):
    try:
        return stream.isatty()
    except Exception:  # noqa: BLE001
        return False


def play_intro(use_color=True, stream=None):
    """Play the short in-place signal-burst intro. Caller must have checked tty."""
    out = stream or sys.stdout
    paint = (lambda t: _ANSI["bold"] + _ANSI["cyan"] + t + _ANSI["reset"]) if use_color else (lambda t: t)
    n_lines = INTRO_FRAMES[0].count("\n") + 1
    for i, frame in enumerate(INTRO_FRAMES):
        if i:
            out.write(f"\x1b[{n_lines}A")
        for line in frame.split("\n"):
            out.write("\r" + paint(line.ljust(24)) + "\n")
        out.flush()
        time.sleep(INTRO_DELAY)


class Spinner:
    """One-line ASCII spinner for long steps. Daemon thread, no deps."""

    FRAMES = ["|", "/", "-", "\\"]

    def __init__(self, text="", stream=None):
        self.text = text
        self.stream = stream or sys.stdout
        self._stop = False
        self._thread = None

    def start(self):
        self._thread = threading.Thread(target=self._spin, daemon=True)
        self._thread.start()

    def _spin(self):
        i = 0
        while not self._stop:
            try:
                self.stream.write(f"\r{self.FRAMES[i % len(self.FRAMES)]} {self.text}")
                self.stream.flush()
            except Exception:  # noqa: BLE001
                break
            time.sleep(0.08)
            i += 1

    def stop(self):
        self._stop = True
        if self._thread:
            self._thread.join(timeout=0.3)
            self._thread = None
        try:
            self.stream.write("\r" + " " * (len(self.text) + 4) + "\r")
            self.stream.flush()
        except Exception:  # noqa: BLE001
            pass


