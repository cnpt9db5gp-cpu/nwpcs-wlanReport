def build_parser():
    p = argparse.ArgumentParser(prog="wlan-report",
                                description="Linux netsh wlanreport equivalent: scan Wi-Fi around you and build a browser-openable HTML report.")
    p.add_argument("--iface", default=None, help="Wi-Fi interface (default: auto-detect)")
    p.add_argument("--no-banner", action="store_true", help="skip the ASCII art banner")
    p.add_argument("--no-color", action="store_true", help="disable ANSI colors")
    p.add_argument("--no-animate", action="store_true", default=argparse.SUPPRESS,
                   help="disable animations (intro + spinners)")
    p.add_argument("-V", "--version", action="version", version=f"%(prog)s {VERSION}")
    sub = p.add_subparsers(dest="cmd")

    s = sub.add_parser("scan", help="list nearby Wi-Fi networks in the terminal (like `netsh wlan show networks`)")
    s.add_argument("--iface", default=argparse.SUPPRESS)
    s.add_argument("--no-banner", action="store_true", default=argparse.SUPPRESS)
    s.add_argument("--no-color", action="store_true", default=argparse.SUPPRESS)
    s.add_argument("--no-animate", action="store_true", default=argparse.SUPPRESS)
    s.add_argument("--no-rescan", action="store_true", help="skip fresh rescan, use cached results (faster)")
    s.add_argument("--json", action="store_true", help="output JSON instead of table")
    s.add_argument("--limit", type=int, default=0, help="show only top N networks")
    s.add_argument("--sort", choices=["signal", "channel", "ssid"], default="signal")

    i = sub.add_parser("info", help="show current connection summary in the terminal")
    i.add_argument("--iface", default=argparse.SUPPRESS)
    i.add_argument("--no-banner", action="store_true", default=argparse.SUPPRESS)
    i.add_argument("--no-color", action="store_true", default=argparse.SUPPRESS)
    i.add_argument("--no-animate", action="store_true", default=argparse.SUPPRESS)
    i.add_argument("--no-rescan", action="store_true")
    i.add_argument("--no-ping", action="store_true", help="skip ping tests (faster/offline)")
    i.add_argument("--json", action="store_true")

    c = sub.add_parser("chat", help="interactive chatbox mode: talk to the diagnostic assistant")
    c.add_argument("--iface", default=argparse.SUPPRESS)
    c.add_argument("--no-banner", action="store_true", default=argparse.SUPPRESS)
    c.add_argument("--no-color", action="store_true", default=argparse.SUPPRESS)
    c.add_argument("--no-animate", action="store_true", default=argparse.SUPPRESS)

    d = sub.add_parser("check-deps", aliases=["doctor"],
                       help="verify tools, permissions and Wi-Fi readiness before diagnosing")
    d.add_argument("--iface", default=argparse.SUPPRESS)
    d.add_argument("--no-banner", action="store_true", default=argparse.SUPPRESS)
    d.add_argument("--no-color", action="store_true", default=argparse.SUPPRESS)
    d.add_argument("--no-animate", action="store_true", default=argparse.SUPPRESS)
    d.add_argument("--json", action="store_true", help="output machine-readable JSON")

    r = sub.add_parser("report", help="generate the HTML report (like `netsh wlanreport`)")
    r.add_argument("--iface", default=argparse.SUPPRESS)
    r.add_argument("--no-banner", action="store_true", default=argparse.SUPPRESS)
    r.add_argument("--no-color", action="store_true", default=argparse.SUPPRESS)
    r.add_argument("--no-animate", action="store_true", default=argparse.SUPPRESS)
    r.add_argument("-o", "--output", default=DEFAULT_OUT, help=f"output HTML path (default: {DEFAULT_OUT})")
    r.add_argument("--json-out", default=None, help="also write raw JSON here (default: <output>-data.json)")
    r.add_argument("--no-json", action="store_true", help="don't write the sidecar JSON file")
    r.add_argument("--chat-log", default=None, help="write chat transcript here (default: <output>-chat.log)")
    r.add_argument("--no-chat-log", action="store_true", help="don't write the chat transcript file")
    r.add_argument("--no-rescan", action="store_true")
    r.add_argument("--no-ping", action="store_true")
    r.add_argument("--log-minutes", type=int, default=60, help="how much journal history to embed (default: 60)")
    r.add_argument("--open", action="store_true", help="open the report in a browser after generating")
    r.add_argument("--serve", action="store_true", help="serve the report over HTTP after generating")
    r.add_argument("--bind", default="127.0.0.1")
    r.add_argument("--port", type=int, default=8000)

    v = sub.add_parser("serve", help="serve an existing report over HTTP and optionally open it")
    v.add_argument("file", nargs="?", default=DEFAULT_OUT, help="HTML file to serve")
    v.add_argument("--bind", default="127.0.0.1")
    v.add_argument("--port", type=int, default=8000)
    v.add_argument("--open", action="store_true", help="open browser to the served URL")

    o = sub.add_parser("open", help="open a report HTML file in your browser")
    o.add_argument("file", nargs="?", default=DEFAULT_OUT, help="HTML file to open")
    o.add_argument("--no-banner", action="store_true", default=argparse.SUPPRESS)
    o.add_argument("--no-color", action="store_true", default=argparse.SUPPRESS)
    o.add_argument("--no-animate", action="store_true", default=argparse.SUPPRESS)
    return p


def cmd_chat(iface, use_color=True, banner=True, animate=False):
    """Interactive chatbox loop: `you>` prompt, wlan-bot answers + runs scans."""
    chat = ChatLog(use_color=use_color, animate=animate)
    if banner:
        show_banner(use_color=use_color)
    chat.box("wlan-report chat",
             "commands: check | scan | info | report [-o file] | open | serve [port] | log | clear | help | exit")
    chat.say("wlan", f"hey! watching {iface} for you. what should we diagnose?")
    last_report = DEFAULT_OUT
    HELP = ("check ......... verify tools + permissions (check-deps)\n"
            "scan .......... list nearby networks\n"
            "info .......... current connection summary\n"
            "report ........ generate HTML report (report -o /tmp/x.html)\n"
            "open .......... open last report in browser\n"
            "serve [port] .. serve last report over HTTP\n"
            "log ........... show this chat transcript\n"
            "clear ......... clear the screen\n"
            "help .......... this help\n"
            "exit .......... leave (transcript is saved)")
    while True:
        try:
            line = input("you> ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            chat.say("wlan", "bye! transcript saved.")
            break
        if not line:
            continue
        chat.say("you", line)
        parts = line.split()
        cmd, rest = parts[0].lower(), parts[1:]
        if cmd in ("exit", "quit", "q", "bye"):
            chat.say("wlan", "bye! happy surfing.")
            break
        elif cmd == "help":
            print(HELP)
            chat.say("wlan", "here is what I understand ^")
        elif cmd == "clear":
            run(["clear"])
            show_banner(use_color=use_color)
        elif cmd == "log":
            for e in chat.entries:
                print(f"[{e['t']}] {e['role']:>4} | {e['text']}")
        elif cmd in ("check", "doctor", "check-deps"):
            chat.say("wlan", "checking your tools + permissions…")
            code = print_check_report(check_capabilities(iface), use_color=use_color)
            chat.say("wlan", "all good — say 'scan' to start." if code == 0
                     else "some checks need attention ^ — fix them, then say 'check' again.")
        elif cmd == "scan":
            chat.say("wlan", "on it — scanning the airwaves…")
            nets = get_wifi_networks(iface, rescan=True, log=chat)
            print_scan_table(nets)
            chat.say("wlan", f"done — {len(nets)} network(s). say 'report' for the full HTML page.")
        elif cmd == "info":
            chat.say("wlan", "checking your link…")
            data = collect_all(iface, rescan=False, do_ping=True, log=chat)
            print_info(data)
            chat.say("wlan", "that is your current link. 'scan' shows the neighbors.")
        elif cmd == "report":
            out = DEFAULT_OUT
            if rest:
                if rest[0] in ("-o", "--output") and len(rest) > 1:
                    out = rest[1]
                elif not rest[0].startswith("-"):
                    out = rest[0]
            chat.say("wlan", f"building the full HTML report → {out} …")
            data = collect_all(iface, rescan=True, do_ping=True, log=chat)
            data["chat"] = list(chat.entries)
            html_doc = render_html(data)
            op = pathlib.Path(out)
            op.parent.mkdir(parents=True, exist_ok=True)
            op.write_text(html_doc, encoding="utf-8")
            last_report = str(op)
            chat.box("report ready", f"{op}\n{len(data['nets'])} networks — open it in a browser!")
        elif cmd == "open":
            uri = pathlib.Path(last_report).resolve().as_uri()
            chat.say("wlan", f"opening {uri}")
            if not open_in_browser(uri):
                chat.say("wlan", f"could not auto-open — paste this in a browser: {uri}")
        elif cmd == "serve":
            port = int(rest[0]) if rest and rest[0].isdigit() else 8000
            chat.say("wlan", f"serving {last_report} on port {port} (Ctrl+C to stop)…")
            serve_file(last_report, port=port, open_browser=True)
            chat.say("wlan", "server stopped — back in chat. what next?")
        else:
            chat.say("wlan", f"hmm, I don't know '{cmd}'. try: help")
    try:
        tp = pathlib.Path.home() / "wlan-report-chat.log"
        chat.save(str(tp))
        print(f"chat transcript: {tp}")
    except Exception:  # noqa: BLE001
        pass


def main(argv=None):
    # legacy: `wlan-report out.html` (no subcommand) == `wlan-report report -o out.html`
    if argv is None:
        argv = sys.argv[1:]
    if argv and argv[0] not in ("scan", "info", "chat", "check-deps", "doctor", "report", "serve", "open", "-h", "--help", "-V", "--version") and not argv[0].startswith("-"):
        argv = ["report", "-o"] + argv
    args = build_parser().parse_args(argv)
    cmd = args.cmd or "report"  # default when only global flags given

    use_color = _color_enabled(getattr(args, "no_color", False))
    json_mode = bool(getattr(args, "json", False))
    want_banner = (not getattr(args, "no_banner", False)) and not json_mode
    animate = (not getattr(args, "no_animate", False)) and not json_mode
    try:
        animate = bool(animate and sys.stdout.isatty())
    except Exception:  # noqa: BLE001
        animate = False
    chat = ChatLog(use_color=use_color, quiet=json_mode, animate=animate)

    iface = detect_iface(getattr(args, "iface", None))

    if cmd == "chat":
        cmd_chat(iface, use_color=use_color, banner=want_banner, animate=animate)
        return

    if cmd in ("check-deps", "doctor"):
        if want_banner:
            if animate:
                play_intro(use_color=use_color)
            show_banner(use_color=use_color)
        checks = check_capabilities(getattr(args, "iface", None))
        if getattr(args, "json", False):
            print(json.dumps(checks, indent=2))
            sys.exit(0 if all(c["ok"] or c["level"] == "optional" for c in checks) else 1)
        sys.exit(print_check_report(checks, use_color=use_color))

    if want_banner:
        if animate:
            play_intro(use_color=use_color)
        show_banner(use_color=use_color)

    if cmd == "scan":
        chat.say("you", f"scan on {iface}")
        nets = get_wifi_networks(iface, rescan=not args.no_rescan, log=None if json_mode else chat)
        if args.json:
            print(json.dumps(nets, indent=2))
        else:
            print(f"\nInterface: {iface}  ({len(nets)} networks)\n")
            print_scan_table(nets, limit=args.limit, sort=args.sort)
        return

    if cmd == "info":
        chat.say("you", f"info on {iface}")
        data = collect_all(iface, rescan=not args.no_rescan, do_ping=not args.no_ping,
                           log=None if json_mode else chat)
        if args.json:
            slim = {"iface": iface, "device": data["dev_kv"], "networks": data["nets"],
                    "ping_gw": data["ping_gw"], "ping_ext": data["ping_ext"], "ping_dns": data["ping_dns"]}
            print(json.dumps(slim, indent=2))
        else:
            print()
            print_info(data)
        return

    if cmd == "serve":
        serve_file(args.file, bind=args.bind, port=args.port, open_browser=args.open)
        return

    if cmd == "open":
        target = pathlib.Path(args.file)
        if not target.exists():
            print(f"error: file not found: {target}", file=sys.stderr)
            print(f"generate one first: wlan-report report -o {target}", file=sys.stderr)
            sys.exit(1)
        uri = target.resolve().as_uri()
        chat.say("you", f"open {target}")
        print(f"Opening {uri}")
        if open_in_browser(uri):
            chat.say("ok", f"opened {target} in your browser")
        else:
            print("could not launch a browser automatically.")
            print(f"paste this into your browser's address bar: {uri}")
            chat.say("warn", "no browser launcher found — URL printed above for manual opening")
        return

    # report (default)
    out = getattr(args, "output", DEFAULT_OUT)
    json_out = getattr(args, "json_out", None)
    no_json = getattr(args, "no_json", False)
    chat_log = getattr(args, "chat_log", None)
    no_chat_log = getattr(args, "no_chat_log", False)
    do_ping = not getattr(args, "no_ping", False)
    rescan = not getattr(args, "no_rescan", False)
    log_minutes = getattr(args, "log_minutes", 60)
    chat.say("you", f"report on {iface} → {out}")
    chat.say("wlan", "on it — running the full diagnostic…")
    data = collect_all(iface, rescan=rescan, do_ping=do_ping, log_minutes=log_minutes, log=chat)
    chat.step("render", "rendering HTML report")
    data["chat"] = list(chat.entries)
    html_doc = render_html(data, log_minutes=log_minutes)
    chat.done("render", "HTML rendered")
    out_path = pathlib.Path(out)
    out_path.parent.mkdir(parents=True, exist_ok=True)
    out_path.write_text(html_doc, encoding="utf-8")
    chat.say("ok", f"wrote {out_path} ({len(data['nets'])} networks)")
    print(f"Wrote {out_path} ({len(data['nets'])} networks)")
    if not no_json:
        jp = pathlib.Path(json_out) if json_out else out_path.with_name(out_path.stem + "-data.json")
        raw = {"generated": datetime.datetime.now().astimezone().isoformat(),
               "hostname": socket.gethostname(), "iface": iface,
               "networks": data["nets"], "device": data["dev_kv"],
               "ping_gw": data["ping_gw"], "ping_ext": data["ping_ext"], "ping_dns": data["ping_dns"],
               "iw_link": data["iw_link"], "iw_station": data["iw_station"]}
        jp.write_text(json.dumps(raw, indent=2), encoding="utf-8")
        print(f"Wrote {jp}")
    if not no_chat_log:
        cp = pathlib.Path(chat_log) if chat_log else out_path.with_name(out_path.stem + "-chat.log")
        chat.save(str(cp))
        print(f"Wrote {cp} (chat transcript)")
    if getattr(args, "open", False) and not getattr(args, "serve", False):
        uri = out_path.resolve().as_uri()
        print(f"Opening {uri}")
        if not open_in_browser(uri):
            print(f"Open this in a browser: {uri}")
    if getattr(args, "serve", False):
        serve_file(str(out_path), bind=args.bind, port=args.port, open_browser=True)


if __name__ == "__main__":
    main()
