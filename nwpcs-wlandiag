    """Extract (ssid, bssid, dbm) of the current connection from collected data."""
    nets = data.get("nets", [])
    cur = next((n for n in nets if n.get("IN-USE") == "*"), None)
    m = re.search(r"signal:\s*(-?\d+)\s*dBm", data.get("iw_link", ""))
    if m:
        dbm = int(m.group(1))
    elif cur:
        dbm = signal_to_dbm(cur["SIGNAL_INT"])
    else:
        dbm = None
    ms = re.search(r"SSID:\s*(.+)", data.get("iw_link", ""))
    mb = re.search(r"Connected to\s*([0-9a-f:]+)", data.get("iw_link", ""))
    ssid = ms.group(1).strip() if ms else (cur["SSID"] if cur else "")
    bssid = mb.group(1) if mb else (cur["BSSID"] if cur else "")
    return ssid, bssid, dbm


def svg_history(series, width=560, height=150, max_points=60):
    """Inline SVG line chart (grayscale, no deps). series: {label: [(ts, val)]}."""
    esc = html.escape
    shades = ["#000000", "#444444", "#777777", "#aaaaaa", "#cccccc"]
    pad_l, pad_b, pad_t = 34, 18, 8
    iw, ih = width - pad_l - 8, height - pad_t - pad_b
    if not series:
        return '<p class="muted">No history yet — run a few scans and this chart fills in.</p>'
    tmin = min(t for pts in series.values() for t, _ in pts[-max_points:])
    tmax = max(t for pts in series.values() for t, _ in pts[-max_points:]) or (tmin + 1)
    if tmax == tmin:
        tmax = tmin + 1

    def x(t):
        return pad_l + (t - tmin) / (tmax - tmin) * iw

    def y(v):
        v = max(0, min(100, v))
        return pad_t + (100 - v) / 100 * ih

    parts = [f'<svg viewBox="0 0 {width} {height}" style="width:100%;height:auto" role="img">']
    for gv in (0, 25, 50, 75, 100):
        yy = y(gv)
        parts.append(f'<line x1="{pad_l}" y1="{yy}" x2="{width - 8}" y2="{yy}" stroke="#d4d4d4" stroke-width="1"/>'
                     f'<text x="2" y="{yy + 4}" font-size="10" fill="#5c5c5c">{gv}</text>')
    for i, (label, pts) in enumerate(list(series.items())[:5]):
        pts = pts[-max_points:]
        d = "M" + " L".join(f"{x(t):.1f},{y(v):.1f}" for t, v in pts)
        parts.append(f'<path d="{d}" fill="none" stroke="{shades[i % len(shades)]}" stroke-width="2"/>')
    t0 = datetime.datetime.fromtimestamp(tmin).strftime("%H:%M")
    t1 = datetime.datetime.fromtimestamp(tmax).strftime("%H:%M")
    parts.append(f'<text x="{pad_l}" y="{height - 4}" font-size="10" fill="#5c5c5c">{esc(t0)}</text>'
                 f'<text x="{width - 34}" y="{height - 4}" font-size="10" fill="#5c5c5c">{esc(t1)}</text>')
    lx = pad_l
    for i, label in enumerate(list(series.keys())[:5]):
        parts.append(f'<circle cx="{lx}" cy="10" r="3" fill="{shades[i % len(shades)]}"/>'
                     f'<text x="{lx + 6}" y="13" font-size="10" fill="#111">{esc(label[:22])}</text>')
        lx += len(label[:22]) * 6 + 22
    parts.append("</svg>")
    return "".join(parts)


# ------------------------------------------------- channel advisor

# 2.4 GHz channels overlap: an AP on ch N also pollutes N±1..4 with falloff.
_OVERLAP_24 = {0: 1.0, 1: 0.8, 2: 0.6, 3: 0.4, 4: 0.2}
_PREFERRED_24 = (1, 6, 11)  # non-overlapping classics


def _chan_num(n):
    try:
        return int(str(n.get("CHAN", "")).strip())
    except (TypeError, ValueError):
        return None


def advise_channels(nets):
    """Score every candidate channel; return {'2.4 GHz': [...], '5 GHz': [...]}.

    Each entry: {'chan': int, 'score': float (0-100, higher = cleaner),
    'note': str}. Scores weight interferers by signal strength.
    """
    out = {"2.4 GHz": [], "5 GHz": []}
    nets24 = [n for n in nets if (n.get("BAND") or "") == "2.4 GHz" and _chan_num(n)]
    nets5 = [n for n in nets if (n.get("BAND") or "") == "5 GHz" and _chan_num(n)]
    if nets24:
        chans = sorted({c for c in range(1, 14)})
        scored = []
        for c in chans:
            noise = 0.0
            for n in nets24:
                d = abs(_chan_num(n) - c)
                if d <= 4:
                    noise += max(0, n.get("SIGNAL_INT", 0)) * _OVERLAP_24[d]
            score = max(0.0, 100.0 - noise / 2.5)
            if c in _PREFERRED_24:
                score = min(100.0, score + 5)
            note = ("non-overlapping classic" if c in _PREFERRED_24 else "overlaps neighbors")
            sharers = sum(1 for n in nets24 if _chan_num(n) == c)
            if sharers:
                note += f" · {sharers} AP(s) on-channel"
            scored.append({"chan": c, "score": round(score, 1), "note": note})
        out["2.4 GHz"] = sorted(scored, key=lambda e: e["score"], reverse=True)[:3]
    if nets5:
        chans = sorted({_chan_num(n) for n in nets5})
        scored = []
        for c in chans:
            sharers = [n for n in nets5 if _chan_num(n) == c]
            noise = sum(max(0, n.get("SIGNAL_INT", 0)) for n in sharers)
            score = max(0.0, 100.0 - noise / 2.0)
            note = f"{len(sharers)} AP(s) co-channel" if sharers else "empty"
            scored.append({"chan": c, "score": round(score, 1), "note": note})
        out["5 GHz"] = sorted(scored, key=lambda e: e["score"], reverse=True)[:3]
    return out


# ------------------------------------------------- speed test (download)

SPEED_URLS = [
    "https://speed.cloudflare.com/__down?bytes={n}",
    "http://cachefly.cachefly.net/{mb}mb.test",
]
SPEED_QUICK_BYTES = 5_000_000


def _pick_speed_url(nbytes):
    for tpl in SPEED_URLS:
        if "{n}" in tpl:
            return tpl.format(n=nbytes)
        if "{mb}" in tpl:
            mb = max(1, round(nbytes / 1_000_000))
            if mb in (1, 5, 10, 25, 50, 100):
                return tpl.format(mb=mb)
    return SPEED_URLS[0].format(n=nbytes)


def measure_download(nbytes=SPEED_QUICK_BYTES, timeout=30):
    """Download nbytes and return {'mbps', 'seconds', 'bytes', 'url'} or {'error'}."""
    url = _pick_speed_url(nbytes)
    try:
        t0 = time.time()
        req = urllib.request.Request(url, headers={"User-Agent": "nwpcs-wlandiag/speedtest"})
        got = 0
        with urllib.request.urlopen(req, timeout=timeout) as r:
            while got < nbytes:
                chunk = r.read(min(256 * 1024, nbytes - got))
                if not chunk:
                    break
                got += len(chunk)
        dt = time.time() - t0
        if got <= 0 or dt <= 0:
            return {"error": "empty response from speed server"}
        return {"mbps": round(got * 8 / dt / 1_000_000, 1), "seconds": round(dt, 1),
                "bytes": got, "url": url}
    except Exception as e:  # noqa: BLE001
        return {"error": f"{type(e).__name__}: {e}"}


# ------------------------------------------------- security audit

def audit_security(nets, cur_bssid=""):
    """Return list of (severity, title, detail). Severity: crit/high/info/good."""
    findings = []
    opens = [n for n in nets if sec_label(n.get("SECURITY", "")).startswith("Open")]
    if opens:
        names = ", ".join(n["SSID_DISP"] for n in opens[:5])
        findings.append(("crit", f"{len(opens)} open network(s) nearby",
                         f"No encryption at all ({names}). Never join these for anything sensitive."))
    weps = [n for n in nets if "WEP" in (n.get("SECURITY") or "").upper()]
    if weps:
        findings.append(("crit", f"{len(weps)} WEP network(s) nearby",
                         "WEP is broken in minutes. Avoid; tell the owner to switch to WPA2/WPA3."))
    wpa1 = [n for n in nets if "WPA1" in (n.get("SECURITY") or "").upper()]
    if wpa1:
        findings.append(("high", f"{len(wpa1)} WPA1/TKIP network(s) nearby",
                         "TKIP is deprecated and drags down the whole 2.4 GHz band. Avoid joining."))
    groups = collections.defaultdict(list)
    for n in nets:
        if n.get("SSID"):
            groups[n["SSID"]].append(n)
    for ssid, members in groups.items():
        secs = {sec_label(m.get("SECURITY", "")) for m in members}
        if len(members) > 1 and len(secs) > 1:
            findings.append(("high", f"Mixed security on '{ssid}'",
                             f"{len(members)} BSSIDs advertise different security "
                             f"({', '.join(sorted(secs))}). Confirm they are all yours — "
                             "a stranger AP reusing your SSID with weaker security is the classic evil-twin setup."))
        elif len(members) > 1 and any(sec_label(m.get("SECURITY", "")).startswith("Open") for m in members):
            findings.append(("crit", f"Open twin of '{ssid}'",
                             "An open AP broadcasts the same name as a secured one. Do not connect to the open one."))
    curs = [n for n in nets if n.get("IN-USE") == "*" or (cur_bssid and n.get("BSSID") == cur_bssid)]
    if curs:
        c = curs[0]
        label = sec_label(c.get("SECURITY", ""))
        if "WPA3" in label:
            findings.append(("good", "Current connection uses WPA3", f"{c['SSID_DISP']} negotiates {label}."))
        elif label == "WPA2":
            findings.append(("good", "Current connection uses WPA2", "Solid baseline (CCMP)."))
        else:
            findings.append(("high", f"Current connection uses {label}",
                             "Your own link is on weak security — fix your router first."))
    if not findings:
        findings.append(("good", "Nothing alarming", "No open/WEP/rogue-twin signs in this scan."))
    order = {"crit": 0, "high": 1, "info": 2, "good": 3}
    return sorted(findings, key=lambda f: order.get(f[0], 4))


# ------------------------------------------------- offline fix-it kit

# Every repair lives here as code AND as copy-paste commands (see
# repair_kit_html / `fix --list`), so fixes stay available with no internet.
# Steps are standard, reversible NetworkManager operations. Disruptive ones
# (reconnect, restart) ask first unless --yes is given.

def _needs_root():
    try:
        return os.geteuid() != 0
    except AttributeError:
        return True


def _sudo(cmd):
    if _needs_root() and shutil.which("sudo"):
        return ["sudo"] + cmd
    return cmd


def _confirm(prompt):
    try:
        if not sys.stdin.isatty():
            return False
        ans = input(prompt + " [y/N] ").strip().lower()
        return ans in ("y", "yes")
    except (EOFError, KeyboardInterrupt):
        print()
        return False


def _iw_connected(iface):
    out, _ = run(["iw", "dev", iface, "link"], timeout=10)
    return "Connected to" in out


def _active_conn(iface):
    out, _ = run(["nmcli", "-t", "-f", "GENERAL.CONNECTION", "device", "show", iface], timeout=10)
    m = re.search(r"GENERAL\.CONNECTION:\s*(.+)", out)
    name = m.group(1).strip() if m else ""
    return "" if name in ("", "--") else name


def fix_radio(iface, log=None):
    out, _ = run(["nmcli", "radio", "wifi"], timeout=10)
    if out.strip() == "enabled":
        return "ok", "Wi-Fi radio already on"
    out2, code = run(["nmcli", "radio", "wifi", "on"], timeout=10)
    return ("fixed", "Wi-Fi radio turned on") if code == 0 else ("failed", out2[-200:])


def fix_rfkill(iface, log=None):
    if shutil.which("rfkill") is None:
        return "skipped", "rfkill not installed — unlikely to be blocked"
    out, _ = run(["rfkill", "list", "wifi"], timeout=10)
    blocked = bool(re.search(r"soft blocked:\s*yes|hard blocked:\s*yes", out, re.I))
    if not blocked and out and "missing" not in out:
        return "ok", "no RF kill switches active"
    out2, code = run(_sudo(["rfkill", "unblock", "wifi"]), timeout=10)
    return ("fixed", "RF kill cleared") if code == 0 else ("failed", out2[-200:])


def fix_rescan(iface, log=None):
    _, code = run(["nmcli", "device", "wifi", "rescan", "ifname", iface], timeout=15)
    time.sleep(2)
    return ("ok", "fresh scan requested") if code == 0 else ("failed", "rescan rejected by NetworkManager")


def fix_reconnect(iface, log=None):
    name = _active_conn(iface)
    if not name:
        out, _ = run(["nmcli", "-t", "-f", "NAME,TYPE,TIMESTAMP", "connection", "show"], timeout=10)
        cands = [l.split(":")[0] for l in out.splitlines()
                 if ":802-11-wireless:" in l and l.split(":")[0]]
        if not cands:
            return "failed", "no saved Wi-Fi profiles to join"
        name = cands[0]
    run(["nmcli", "connection", "down", name], timeout=15)
    time.sleep(1)
    out, code = run(["nmcli", "connection", "up", name], timeout=30)
    if code != 0:
        return "failed", out[-200:]
    for _ in range(15):
        if _iw_connected(iface):
            return "fixed", f"reconnected to '{name}'"
        time.sleep(1)
    return "failed", f"'{name}' did not associate within 15s"


def fix_dhcp(iface, log=None):
    out, code = run(["nmcli", "device", "reapply", iface], timeout=20)
    if code != 0:
        name = _active_conn(iface)
        if name:
            run(["nmcli", "connection", "down", name], timeout=15)
            time.sleep(1)
            out, code = run(["nmcli", "connection", "up", name], timeout=30)
    if code != 0:
        return "failed", out[-200:] if out else "DHCP renew rejected"
    time.sleep(2)
    ip4, _ = run(["nmcli", "-t", "-f", "IP4.ADDRESS", "device", "show", iface], timeout=10)
    if "169.254." in ip4 or "ADDRESS" not in ip4:
        return "failed", "still no valid lease (APIPA or empty)"
    return "fixed", "DHCP lease renewed"


def fix_dns_flush(iface, log=None):
    for cmd in (["resolvectl", "flush-caches"], ["systemd-resolve", "--flush-caches"]):
        if shutil.which(cmd[0]) is None:
            continue
        _, code = run(cmd, timeout=10)
        if code == 0:
            return "fixed", "DNS cache flushed"
    return "skipped", "no DNS flush tool found"


def _dns_backup_path():
    return data_dir() / "dns-backup.json"


def fix_dns_switch(iface, log=None):
    name = _active_conn(iface)
    if not name:
        return "failed", "no active connection to modify (connect first)"
    cur, _ = run(["nmcli", "-t", "-f", "ipv4.dns,ipv4.ignore-auto-dns",
                  "connection", "show", name], timeout=10)
    try:
        data_dir().mkdir(parents=True, exist_ok=True)
        _dns_backup_path().write_text(json.dumps({"connection": name, "was": cur}), encoding="utf-8")
    except Exception:  # noqa: BLE001
        pass
    cmds = [["nmcli", "connection", "modify", name, "ipv4.dns", "1.1.1.1,8.8.8.8",
             "ipv4.ignore-auto-dns", "yes"],
            ["nmcli", "connection", "up", name]]
    last = ""
    for c in cmds:
        last, code = run(c, timeout=20)
        if code != 0 and "not authorized" in last.lower() and shutil.which("sudo"):
            last, code = run(["sudo"] + c, timeout=20)
        if code != 0:
            return "failed", last[-200:]
    time.sleep(2)
    probe, _ = run(["getent", "hosts", "google.com"], timeout=10)
    if probe.strip():
        return "fixed", "DNS now via 1.1.1.1,8.8.8.8 (previous saved — `fix --undo-dns` reverts)"
    return "failed", "DNS still not resolving after switch"


def fix_dns_undo(iface, log=None):
    try:
        bak = json.loads(_dns_backup_path().read_text(encoding="utf-8"))
    except Exception:  # noqa: BLE001
        return "failed", "no DNS backup found — nothing to revert"
    return ("fixed", f"revert with: nmcli connection modify '{bak['connection']}' "
                     f"ipv4.dns \"\" ipv4.ignore-auto-dns no && nmcli connection up '{bak['connection']}'")


def fix_nm_restart(iface, log=None):
    if shutil.which("systemctl") is None:
        return "skipped", "no systemctl here"
    _, code = run(_sudo(["systemctl", "restart", "NetworkManager"]), timeout=30)
    if code != 0:
        return "failed", "restart rejected (need sudo?)"
    for _ in range(30):
        time.sleep(1)
        out, code = run(["nmcli", "general", "status"], timeout=10)
        if code == 0:
            if _iw_connected(iface):
                return "fixed", "NetworkManager restarted, link re-associated"
            return "ok", "NetworkManager restarted (reconnect manually if needed)"
    return "failed", "NetworkManager did not come back within 30s"


