class ChatLog:
    """Chat-style progress + interaction transcript.

    Prints chat-like lines to the terminal while recording every entry so
    the same conversation can be embedded in the HTML report ('Session chat
    log') and saved to a `-chat.log` text file.
    Roles: you, wlan, sys, step, done, ok, warn, err.
    """

    def __init__(self, use_color=True, stream=None, quiet=False):
        self.use_color = use_color
        self.stream = stream or sys.stdout
        self.quiet = quiet
        self.entries = []
        self._t0 = time.time()
        self._steps = {}

    def _paint(self, color, text):
        if not self.use_color:
            return text
        return _ANSI.get(color, "") + text + _ANSI["reset"]

    def _emit(self, text):
        if not self.quiet:
            self.stream.write(text + "\n")
            self.stream.flush()

    def _record(self, role, text):
        ts = datetime.datetime.now().astimezone().strftime("%H:%M:%S")
        self.entries.append({"t": ts, "role": role, "text": text})
        return ts

    def say(self, role, text):
        ts = self._record(role, text)
        mark = {"you": "you >", "wlan": "wlan|", "sys": "sys |",
                "step": " -- >", "done": " <--", "ok": " ok |",
                "warn": " !! |", "err": "FAIL|"}.get(role, "    |")
        self._emit(f"{self._paint('dim', '[' + ts + ']')} "
                   f"{self._paint(_ROLE_COLOR.get(role, 'dim'), mark)} {text}")

    def step(self, key, text):
        self._steps[key] = time.time()
        label = text + " ..."
        self._record("step", label)
        if self.quiet:
            return
        mark = self._paint("blue", " -- >")
        self._emit(f"{self._paint('dim', '[' + self.entries[-1]['t'] + ']')} {mark} {label}")

    def done(self, key, text=""):
        dt = time.time() - self._steps.pop(key, time.time())
        extra = f" ({dt:.1f}s)" if dt < 120 else f" ({dt / 60:.1f} min)"
        self.say("done", (text + extra) if text else "done" + extra)

    def box(self, title, body):
        lines = str(body).splitlines() or [""]
        width = max([len(title) + 6] + [len(l) + 4 for l in lines] + [30])
        width = min(width, 76)
        bar = "+" + "-" * (width - 2) + "+"
        self._emit(self._paint("cyan", bar))
        self._emit(self._paint("cyan", "| ") + self._paint("bold", title.upper())
                   + " " * max(0, width - 4 - len(title)) + self._paint("cyan", "|"))
        self._emit(self._paint("cyan", bar))
        inner = width - 4
        wrapped = []
        for line in lines:
            words, cur_line = str(line).split(" "), ""
            if not words or words == [""]:
                wrapped.append("")
                continue
            for w in words:
                while len(w) > inner:  # hard-split overlong words
                    if cur_line:
                        wrapped.append(cur_line)
                        cur_line = ""
                    wrapped.append(w[:inner])
                    w = w[inner:]
                trial = (cur_line + " " + w).strip()
                if len(trial) <= inner:
                    cur_line = trial
                else:
                    wrapped.append(cur_line)
                    cur_line = w
            wrapped.append(cur_line)
        for chunk in wrapped:
            self._emit(self._paint("cyan", "| ") + chunk
                       + " " * (inner - len(chunk)) + self._paint("cyan", " |"))
        self._emit(self._paint("cyan", bar))
        self.entries.append({"t": datetime.datetime.now().astimezone().strftime("%H:%M:%S"),
                             "role": "sys", "text": f"[{title}] {body}"})

    def save(self, path):
        lines = [f"[{e['t']}] {e['role']:>4} | {e['text']}" for e in self.entries]
        header = f"# nwpcs-wlandiag chat transcript v{VERSION} — {socket.gethostname()} — " \
                 f"{datetime.datetime.now().astimezone().isoformat()}\n"
        pathlib.Path(path).write_text(header + "\n".join(lines) + "\n", encoding="utf-8")
        return str(path)


