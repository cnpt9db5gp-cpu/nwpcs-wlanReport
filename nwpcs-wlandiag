def build_report_file(out, iface, chat):
    """Run the full diagnostic and write the HTML report. Returns (path, count)."""
    chat.say("wlan", f"building the full HTML report → {out} …")
    data = collect_all(iface, rescan=True, do_ping=True, log=chat, do_speed=True)
    ssid, bssid, dbm = snapshot_link(data)
    record_history(data["nets"], iface, ssid, bssid, dbm, data["ping_gw"], data["ping_ext"])
    record_bw(iface)
    html_doc = render_html(data)
    op = pathlib.Path(out)
    op.parent.mkdir(parents=True, exist_ok=True)
    op.write_text(html_doc, encoding="utf-8")
    return str(op), len(data["nets"])


def cmd_chat(iface, use_color=True, banner=True):
    """Interactive chatbox loop: `you>` prompt, wlan-bot answers + runs scans."""
    chat = ChatLog(use_color=use_color)
    if banner:
        show_banner(use_color=use_color)
    chat.box("nwpcs-wlandiag chat",
             "commands: check | scan | info | advise | speed | history | bw | fix | report [-o file] | open | serve [port] | log | clear | help | exit")
    chat.say("wlan", f"hey! watching {iface} for you. what should we diagnose?")
    last_report = DEFAULT_OUT
    HELP = ("check ......... verify tools + permissions (check-deps)\n"
            "scan .......... list nearby networks\n"
            "info .......... current connection summary\n"
            "advise ........ best Wi-Fi channels for your router\n"
            "speed ......... measure real download throughput\n"
            "history ....... show recorded signal/link history\n"
            "bw ............ bandwidth workload 24h/7d + normal curve\n"
            "fix ........... diagnose + repair (fix --dry-run to preview)\n"
            "report ........ generate HTML report (report -o /tmp/x.html)\n"
            "open .......... open report in browser (builds one if missing)\n"
            "serve [port] .. serve last report over HTTP\n"
            "log ........... show this chat transcript\n"
            "clear ......... clear the screen\n"
            "help .......... this help\n"
            "exit .......... leave (transcript is saved)")
    while True:
        try:
            line = input("you> ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            chat.say("wlan", "bye! transcript saved.")
            break
        if not line:
            continue
        chat.say("you", line)
        parts = line.split()
        cmd, rest = parts[0].lower(), parts[1:]
        if cmd in ("exit", "quit", "q", "bye"):
            chat.say("wlan", "bye! happy surfing.")
            break
        elif cmd == "help":
            print(HELP)
            chat.say("wlan", "here is what I understand ^")
        elif cmd == "clear":
            run(["clear"])
            show_banner(use_color=use_color)
        elif cmd == "log":
            for e in chat.entries:
                print(f"[{e['t']}] {e['role']:>4} | {e['text']}")
        elif cmd in ("check", "doctor", "check-deps"):
            chat.say("wlan", "checking your tools + permissions…")
            code = print_check_report(check_capabilities(iface), use_color=use_color)
            chat.say("wlan", "all good — say 'scan' to start." if code == 0
                     else "some checks need attention ^ — fix them, then say 'check' again.")
        elif cmd == "scan":
            chat.say("wlan", "on it — scanning the airwaves…")
            nets = get_wifi_networks(iface, rescan=True, log=chat)
            print_scan_table(nets)
            chat.say("wlan", f"done — {len(nets)} network(s). say 'report' for the full HTML page.")
        elif cmd == "info":
            chat.say("wlan", "checking your link…")
            data = collect_all(iface, rescan=False, do_ping=True, log=chat)
            print_info(data)
            chat.say("wlan", "that is your current link. 'scan' shows the neighbors.")
        elif cmd == "advise":
            chat.say("wlan", "analyzing channel congestion…")
            nets = get_wifi_networks(iface, rescan=True, log=chat)
            for band in ("2.4 GHz", "5 GHz"):
                picks = advise_channels(nets).get(band, [])
                if picks:
                    best = picks[0]
                    chat.say("wlan", f"best {band}: ch {best['chan']} "
                                     f"(score {best['score']:.0f}/100) — {best['note']}")
            chat.say("wlan", "set that channel on your router, then re-scan to confirm.")
        elif cmd == "speed":
            nbytes = 25_000_000
            if rest and rest[0].isdigit():
                nbytes = max(1_000_000, int(rest[0]))
            chat.say("wlan", f"measuring download ({nbytes // 1_000_000} MB)…")
            res = measure_download(nbytes)
            if "mbps" in res:
                chat.say("wlan", f"download: {res['mbps']} Mbps "
                                 f"({res['bytes'] // 1_000_000} MB in {res['seconds']}s)")
            else:
                chat.say("wlan", f"speed test failed: {res['error']}")
        elif cmd == "history":
            h = read_history(limit=10, days=7)
            if not h["link"] and not h["aps"]:
                chat.say("wlan", "no history yet — run scan/info/report a few times first.")
            else:
                for r in h["link"][:5]:
                    ts = datetime.datetime.fromtimestamp(r["ts"]).strftime("%m-%d %H:%M")
                    chat.say("wlan", f"{ts} · {r['ssid'] or '-'} · "
                                     f"{r['dbm']} dBm · gw {r['ping_gw']} ms · inet {r['ping_ext']} ms")
                chat.say("wlan", "full charts live in your next HTML report.")
        elif cmd == "bw":
            s = bw_summary(iface, days=7)
            if not s["n"]:
                chat.say("wlan", "no bandwidth samples yet — they record on every scan/info/report.")
            else:
                chat.say("wlan", f"7d: {fmt_bytes(s['total_down'])} down / "
                                 f"{fmt_bytes(s['total_up'])} up, "
                                 f"avg {fmt_bytes(s['avg_down'])}/s down.")
                mu, sigma, ng = gauss_fit([d + u for _, d, u in bw_rates(iface, days=7)])
                if ng >= 5 and sigma > 0:
                    chat.say("wlan", f"workload ≈ normal N(μ {fmt_bytes(mu)}/s, σ {fmt_bytes(sigma)}/s), "
                                     f"n={ng}. charts live in your next HTML report.")
                else:
                    chat.say("wlan", "need a few more samples for the normal curve — keep using the tool.")
        elif cmd == "fix":
            if "--list" in rest:
                for st in FIX_STEPS:
                    print(f"  {st['id']:12} {st['title']}")
                chat.say("wlan", "run `fix --only a,b` — or just `fix` and I'll pick.")
            elif "--undo-dns" in rest:
                status, detail = fix_dns_undo(iface, chat)
                chat.say("wlan", f"{status}: {detail}")
            else:
                only = None
                if "--only" in rest:
                    i = rest.index("--only")
                    only = [s.strip() for s in rest[i + 1].split(",")] if i + 1 < len(rest) else []
                dry = "--dry-run" in rest
                if only:
                    plan, problems, notes = only, ["manual selection"], []
                else:
                    chat.say("wlan", "quick diagnosis first…")
                    problems, plan, notes = diagnose_for_fix(iface, log=chat)
                    if "--full" in rest and "nm-restart" not in plan:
                        plan.append("nm-restart")
                if not plan:
                    chat.say("wlan", "link looks healthy — nothing to fix." if not problems
                             else "No automatic fix for: " + "; ".join(problems))
                else:
                    chat.say("wlan", "plan: " + " → ".join(plan))
                    for n in notes:
                        chat.say("wlan", "note: " + n)
                    if dry or "--yes" in rest or _confirm("Run this repair plan?"):
                        run_fix_plan(iface, plan, dry_run=dry, auto_yes=True, log=chat)
                        if not dry:
                            ok, verdict = verify_link_quick(iface)
                            chat.say("wlan", ("fixed! " if ok else "still broken: ") + verdict)
                    else:
                        chat.say("wlan", "aborted — nothing changed.")
        elif cmd == "report":
            out = DEFAULT_OUT
            if rest:
                if rest[0] in ("-o", "--output") and len(rest) > 1:
                    out = rest[1]
                elif not rest[0].startswith("-"):
                    out = rest[0]
            last_report, n = build_report_file(out, iface, chat)
            chat.box("report ready", f"{last_report}\n{n} networks — open it in a browser!")
        elif cmd == "open":
            if not pathlib.Path(last_report).exists():
                chat.say("wlan", "no report yet — building one first, then opening…")
                last_report, n = build_report_file(last_report, iface, chat)
                chat.box("report ready", f"{last_report}\n{n} networks — opening it now!")
            uri = pathlib.Path(last_report).resolve().as_uri()
            chat.say("wlan", f"opening {uri}")
            if not open_in_browser(uri):
                chat.say("wlan", f"could not auto-open — paste this in a browser: {uri}")
        elif cmd == "serve":
            if not pathlib.Path(last_report).exists():
                chat.say("wlan", "no report yet — say 'report' first, then I can serve it.")
            else:
                port = int(rest[0]) if rest and rest[0].isdigit() else 8000
                chat.say("wlan", f"serving {last_report} on port {port} (Ctrl+C to stop)…")
                serve_file(last_report, port=port, open_browser=True)
                chat.say("wlan", "server stopped — back in chat. what next?")
        else:
            chat.say("wlan", f"hmm, I don't know '{cmd}'. try: help")
    try:
        tp = data_dir() / "nwpcs-wlandiag-chat.log"
        tp.parent.mkdir(parents=True, exist_ok=True)
        chat.save(str(tp))
        print(f"chat transcript: {tp}")
    except Exception:  # noqa: BLE001
        pass


def main(argv=None):
    # legacy: `nwpcs-wlandiag out.html` (no subcommand) == `nwpcs-wlandiag report -o out.html`
    if argv is None:
        argv = sys.argv[1:]
    if argv and argv[0] not in ("scan", "info", "chat", "check-deps", "doctor", "report", "serve", "open", "history", "speed", "fix", "bw", "-h", "--help", "-V", "--version") and not argv[0].startswith("-"):
        argv = ["report", "-o"] + argv
    args = build_parser().parse_args(argv)
    cmd = args.cmd or "chat"  # bare `nwpcs-wlandiag` drops into interactive mode

    use_color = _color_enabled(getattr(args, "no_color", False))
    json_mode = bool(getattr(args, "json", False))
    want_banner = (not getattr(args, "no_banner", False)) and not json_mode
    chat = ChatLog(use_color=use_color, quiet=json_mode)

    iface = detect_iface(getattr(args, "iface", None))

    if cmd == "chat":
        cmd_chat(iface, use_color=use_color, banner=want_banner)
        return

    if cmd in ("check-deps", "doctor"):
        if want_banner:
            show_banner(use_color=use_color)
        checks = check_capabilities(getattr(args, "iface", None))
        if getattr(args, "json", False):
            print(json.dumps(checks, indent=2))
            sys.exit(0 if all(c["ok"] or c["level"] == "optional" for c in checks) else 1)
        sys.exit(print_check_report(checks, use_color=use_color))

    if want_banner:
        show_banner(use_color=use_color)

    if cmd == "scan":
        chat.say("you", f"scan on {iface}")
        nets = get_wifi_networks(iface, rescan=not args.no_rescan, log=None if json_mode else chat)
        if not getattr(args, "no_history", False):
            record_history(nets, iface)
            record_bw(iface)
        if args.json:
            print(json.dumps(nets, indent=2))
        else:
            print(f"\nInterface: {iface}  ({len(nets)} networks)\n")
            print_scan_table(nets, limit=args.limit, sort=args.sort)
        return

    if cmd == "info":
        chat.say("you", f"info on {iface}")
        data = collect_all(iface, rescan=not args.no_rescan, do_ping=not args.no_ping,
                           log=None if json_mode else chat)
        if not getattr(args, "no_history", False):
            ssid, bssid, dbm = snapshot_link(data)
            record_history(data["nets"], iface, ssid, bssid, dbm,
                           data["ping_gw"], data["ping_ext"])
            record_bw(iface)
        if args.json:
            slim = {"iface": iface, "device": data["dev_kv"], "networks": data["nets"],
                    "ping_gw": data["ping_gw"], "ping_ext": data["ping_ext"], "ping_dns": data["ping_dns"]}
            print(json.dumps(slim, indent=2))
        else:
            print()
            print_info(data)
        return

    if cmd == "history":
        if getattr(args, "clear", False):
            ok = clear_history()
            print("history cleared." if ok else "error: could not clear history")
            sys.exit(0 if ok else 1)
        h = read_history(limit=args.limit, days=args.days)
        if getattr(args, "json", False):
            print(json.dumps(h, indent=2))
            return
        if not h["link"] and not h["aps"]:
            print(f"No history yet — run scan/info/report to start recording (stored in {HISTORY_DB})")
            return
        print(f"Link snapshots (last {len(h['link'])}):")
        print(f'{"TIME":16} {"SSID":24} {"SIG":>8}  {"GW":>9}  {"INET":>9}')
        print("-" * 72)
        for r in h["link"]:
            ts = datetime.datetime.fromtimestamp(r["ts"]).strftime("%m-%d %H:%M")
            gw = f"{r['ping_gw']} ms" if r["ping_gw"] is not None else "-"
            ext = f"{r['ping_ext']} ms" if r["ping_ext"] is not None else "-"
            dbm = f"{r['dbm']} dBm" if r["dbm"] is not None else "-"
            print(f"{ts:16} {(r['ssid'] or '-')[:24]:24} {dbm:>8}  {gw:>9}  {ext:>9}")
        if h["aps"]:
            print("\nStrongest networks (7-day max signal):")
            best = sorted(((max(v for _, v in pts), ssid) for ssid, pts in h["aps"].items()),
                          reverse=True)[:8]
            for sig, ssid in best:
                print(f"  {sig:>3}%  {ssid}")
        return

    if cmd == "speed":
        nbytes = max(1_000_000, args.bytes)
        chat.say("you", f"speed test ({nbytes // 1_000_000} MB download)")
        res = measure_download(nbytes)
        if getattr(args, "json", False):
            print(json.dumps(res, indent=2))
            sys.exit(0 if "mbps" in res else 1)
        if "mbps" in res:
            print(f"Download: {res['mbps']} Mbps ({res['bytes'] // 1_000_000} MB in {res['seconds']}s)")
        else:
            print(f"Speed test failed: {res['error']}")
            sys.exit(1)
        return

    if cmd == "bw":
        if args.action == "sample":
            ok = record_bw(iface)
            print(f"sampled {iface}: {'recorded' if ok else 'failed (no counters?)'}")
            sys.exit(0 if ok else 1)
        s = bw_summary(iface, days=args.days)
        if getattr(args, "json", False):
            print(json.dumps(s, indent=2, default=str))
            return
        print_bw(s)
        return

    if cmd == "fix":
        if getattr(args, "list", False):
            print(f"{'STEP':12} {'ROOT':5} TITLE / COMMANDS")
            print("-" * 70)
            for st in FIX_STEPS:
                print(f"{st['id']:12} {'yes' if st.get('root') else 'no':5} {st['title']}")
                for c in st["cmds"]:
                    print(f"{'':12} {'':5} $ {c}")
            return
        if getattr(args, "undo_dns", False):
            status, detail = fix_dns_undo(iface, chat)
            print(f"{status}: {detail}")
            sys.exit(0 if status == "fixed" else 1)
        only = getattr(args, "only", None)
        if only:
            ids = [s.strip() for s in only.split(",") if s.strip()]
            known = {st["id"] for st in FIX_STEPS}
            bad = [s for s in ids if s not in known]
            if bad:
                print(f"error: unknown step(s): {', '.join(bad)} (see `fix --list`)", file=sys.stderr)
                sys.exit(2)
            plan, problems, notes = ids, ["manual step selection"], []
        else:
            chat.say("wlan", "quick diagnosis first…")
            problems, plan, notes = diagnose_for_fix(iface, log=chat)
            if getattr(args, "full", False) and "nm-restart" not in plan:
                plan.append("nm-restart")
        if not plan:
            print("Link looks healthy — nothing to fix." if not problems
                  else "No automatic fix for: " + "; ".join(problems))
            for n in notes:
                print("note: " + n)
            return
        print("Problems: " + "; ".join(problems))
        print("Plan: " + " → ".join(plan))
        for n in notes:
            print("note: " + n)
        dry = bool(getattr(args, "dry_run", False))
        if not dry and not getattr(args, "yes", False) and not _confirm("Run this repair plan?"):
            print("aborted — nothing changed.")
            return
        results = run_fix_plan(iface, plan, dry_run=dry,
                               auto_yes=bool(getattr(args, "yes", False)), log=chat)
        print(f"\n{'STEP':12} {'STATUS':8} DETAIL")
        print("-" * 70)
        failed = 0
        for sid, status, detail in results:
            print(f"{sid:12} {status:8} {detail}")
            if status == "failed":
                failed += 1
        if dry:
            return
        ok, verdict = verify_link_quick(iface)
        print(("\nOK: " if ok else "\nStill broken: ") + verdict)
        sys.exit(0 if ok and not failed else 1)

    if cmd == "serve":
        serve_file(args.file, bind=args.bind, port=args.port, open_browser=args.open)
        return

    if cmd == "open":
        target = pathlib.Path(args.file)
        if not target.exists():
            print(f"error: file not found: {target}", file=sys.stderr)
            print(f"generate one first: nwpcs-wlandiag report -o {target}", file=sys.stderr)
            sys.exit(1)
        uri = target.resolve().as_uri()
        chat.say("you", f"open {target}")
        print(f"Opening {uri}")
        if open_in_browser(uri):
            chat.say("ok", f"opened {target} in your browser")
        else:
            print("could not launch a browser automatically.")
            print(f"paste this into your browser's address bar: {uri}")
            chat.say("warn", "no browser launcher found — URL printed above for manual opening")
        return

    # report (default)
    out = getattr(args, "output", DEFAULT_OUT)
    json_out = getattr(args, "json_out", None)
    no_json = getattr(args, "no_json", False)
    chat_log = getattr(args, "chat_log", None)
    no_chat_log = getattr(args, "no_chat_log", False)
    do_ping = not getattr(args, "no_ping", False)
    do_speed = not getattr(args, "no_speed", False)
    rescan = not getattr(args, "no_rescan", False)
    log_minutes = getattr(args, "log_minutes", 60)
    chat.say("you", f"report on {iface} → {out}")
    chat.say("wlan", "on it — running the full diagnostic…")
    data = collect_all(iface, rescan=rescan, do_ping=do_ping, log_minutes=log_minutes, log=chat,
                       do_speed=do_speed)
    if not getattr(args, "no_history", False):
        ssid, bssid, dbm = snapshot_link(data)
        record_history(data["nets"], iface, ssid, bssid, dbm, data["ping_gw"], data["ping_ext"])
        record_bw(iface)
    chat.step("render", "rendering HTML report")
    html_doc = render_html(data, log_minutes=log_minutes)
    chat.done("render", "HTML rendered")
    out_path = pathlib.Path(out)
    out_path.parent.mkdir(parents=True, exist_ok=True)
    out_path.write_text(html_doc, encoding="utf-8")
    chat.say("ok", f"wrote {out_path} ({len(data['nets'])} networks)")
    print(f"Wrote {out_path} ({len(data['nets'])} networks)")
    if not no_json:
        jp = pathlib.Path(json_out) if json_out else out_path.with_name(out_path.stem + "-data.json")
        raw = {"generated": datetime.datetime.now().astimezone().isoformat(),
               "hostname": socket.gethostname(), "iface": iface,
               "networks": data["nets"], "device": data["dev_kv"],
               "ping_gw": data["ping_gw"], "ping_ext": data["ping_ext"], "ping_dns": data["ping_dns"],
               "speed": data.get("speed", {}),
               "iw_link": data["iw_link"], "iw_station": data["iw_station"]}
        jp.write_text(json.dumps(raw, indent=2), encoding="utf-8")
        print(f"Wrote {jp}")
    if not no_chat_log:
        cp = pathlib.Path(chat_log) if chat_log else out_path.with_name(out_path.stem + "-chat.log")
        chat.save(str(cp))
        print(f"Wrote {cp} (chat transcript)")
    if getattr(args, "open", False) and not getattr(args, "serve", False):
        uri = out_path.resolve().as_uri()
        print(f"Opening {uri}")
        if not open_in_browser(uri):
            print(f"Open this in a browser: {uri}")
    if getattr(args, "serve", False):
        serve_file(str(out_path), bind=args.bind, port=args.port, open_browser=True)


if __name__ == "__main__":
    main()
