        dbm = signal_to_dbm(sig)
        star = "●" if n.get("IN-USE") == "*" else ""
        rows.append(
            f'<tr class="{cls}"><td>{star}</td>'
            f'<td><strong>{esc(n["SSID_DISP"])}</strong><div class="muted mono">{esc(n["BSSID"])}</div></td>'
            f'<td class="mono">{esc(n["CHAN"])}</td>'
            f'<td class="mono">{esc(n["FREQ"])}<div class="muted">{esc(n["BAND"])} · {esc(n["BANDWIDTH"])}</div></td>'
            f'<td><div class="sig"><div class="sigfill" style="width:{bar_w}%;background:{color}"></div></div>'
            f'<span class="mono">{sig}% · ~{dbm} dBm</span><div class="muted">{quality_label(sig)}</div></td>'
            f'<td class="mono">{esc(n["RATE"])}</td>'
            f'<td>{esc(sec_label(n["SECURITY"]))}<div class="muted mono">{esc(n["SECURITY"])}</div></td>'
            f'<td class="muted">{esc(n["MODE"])}</td></tr>')
    rows_html = "".join(rows)
    chan_bars_html = "".join(
        f'<div class="hrow"><span class="mono ch">ch {esc(ch)}</span>'
        f'<div class="hbar"><div class="hfill" style="width:{c / max_chan * 100:.0f}%"></div></div>'
        f'<span class="mono">{c} AP(s)</span></div>'
        for ch, c in sorted(chan_counts.items(),
                            key=lambda x: (int(x[0]) if str(x[0]).isdigit() else 9999)))
    sig_bars_html = "".join(
        f'<div class="hrow"><span class="ssid">{esc(n["SSID_DISP"])} '
        f'<span class="muted mono">{esc(n["BSSID"][-5:])} ch{esc(n["CHAN"])}</span></span>'
        f'<div class="hbar"><div class="hfill sigfill2" style="width:{max(0, min(100, n["SIGNAL_INT"]))}%"></div></div>'
        f'<span class="mono">{n["SIGNAL_INT"]}%</span></div>'
        for n in nets[:12])
    sec_rows_html = "".join(f"<tr><td>{esc(k)}</td><td class='mono'>{v}</td></tr>" for k, v in sec_counts.most_common())
    band_rows_html = "".join(f"<tr><td>{esc(k)}</td><td class='mono'>{v}</td></tr>" for k, v in band_counts.most_common())
    rec_html = "".join(f"<li class='{lvl}'><span class='badge'>{lvl.upper()}</span> {msg}</li>" for lvl, msg in recs)
    log_lines = data["nm_logs"].splitlines()[-80:]
    log_html = "\n".join(esc(line) for line in log_lines) if log_lines else "(no logs)"
    sig_pct = cur["SIGNAL_INT"] if cur else "?"
    sig_qual = quality_label(cur["SIGNAL_INT"]) if cur else ""
    rx_rate = m_rx.group(1).strip() if m_rx else (cur["RATE"] if cur else "-")
    tx_rate = m_tx.group(1).strip() if m_tx else ""
    freq_line = (m_freq.group(1) + " MHz") if m_freq else (cur["FREQ"] if cur else "-")
    cur_chan = cur["CHAN"] if cur else "?"
    cur_bandline = (cur["FREQ"] + " · " + cur["BAND"] + " · " + cur["BANDWIDTH"]) if cur else ""
    cur_sec = sec_label(cur["SECURITY"]) if cur else "-"
    cur_sec_raw = cur["SECURITY"] if cur else ""
    gen_state = dev_kv.get("GENERAL.STATE", "")
    product = dev_kv.get("GENERAL.PRODUCT", "Intel WiFi")
    driver = dev_kv.get("GENERAL.DRIVER", "")
    fw = dev_kv.get("GENERAL.FIRMWARE-VERSION", "")
    raw_bssid = m_bss.group(1) if m_bss else (cur["BSSID"] if cur else "")

    adv = advise_channels(nets)
    advisor_blocks = []
    for band in ("2.4 GHz", "5 GHz"):
        picks = adv.get(band, [])
        if not picks:
            continue
        rows = "".join(
            f'<div class="hrow"><span class="mono ch">ch {p["chan"]}</span>'
            f'<div class="hbar"><div class="hfill" style="width:{p["score"]:.0f}%"></div></div>'
            f'<span class="mono">{p["score"]:.0f}</span>'
            f'<span class="muted">{esc(p["note"])}</span></div>'
            for p in picks)
        best = picks[0]
        advisor_blocks.append(
            f"<h3>{esc(band)} — best: ch {best['chan']} (score {best['score']:.0f}/100)</h3>{rows}")
    advisor_html = "".join(advisor_blocks) or '<p class="muted">Not enough data to advise.</p>'

    sev_map = {"crit": "bad", "high": "warn", "info": "info", "good": "good"}
    audit_html = "".join(
        f"<li class='{sev_map.get(s, 'info')}'><span class='badge'>{s.upper()}</span> "
        f"<strong>{esc(t)}</strong> — {esc(d)}</li>"
        for s, t, d in audit_security(nets, raw_bssid))

    hist = read_history(limit=80, days=7)
    ordered = {}
    if cur and cur.get("SSID") in hist["aps"]:
        ordered[cur["SSID"]] = hist["aps"][cur["SSID"]]
    for ssid, pts in sorted(hist["aps"].items(),
                            key=lambda kv: max(v for _, v in kv[1]), reverse=True):
        if ssid not in ordered:
            ordered[ssid] = pts
        if len(ordered) >= 5:
            break
    hist_svg = svg_history(ordered)
    if hist["link"]:
        def _ms(v):
            return f"{v} ms" if v is not None else "-"
        link_rows_html = "".join(
            f"<tr><td class='mono'>{esc(datetime.datetime.fromtimestamp(r['ts']).strftime('%m-%d %H:%M'))}</td>"
            f"<td>{esc(r['ssid'] or '-')}</td>"
            f"<td class='mono'>{r['dbm'] if r['dbm'] is not None else '-'} dBm</td>"
            f"<td class='mono'>{_ms(r['ping_gw'])}</td><td class='mono'>{_ms(r['ping_ext'])}</td></tr>"
            for r in hist["link"][:8])
    else:
        link_rows_html = ("<tr><td colspan='5' class='muted'>No link snapshots yet — "
                           "they accumulate each time you scan, check info, or build a report.</td></tr>")

    sp = data.get("speed", {}) or {}
    if "mbps" in sp:
        speed_html = (f"<div class='grid'><div class='kpi'><div class='l'>Download throughput</div>"
                      f"<div class='v'>{sp['mbps']} Mbps</div>"
                      f"<div class='muted mono'>{sp['bytes'] // 1_000_000} MB in {sp['seconds']}s</div></div></div>")
    elif "error" in sp:
        speed_html = f"<p class='muted'>Speed test failed: {esc(sp['error'])}</p>"
    else:
        speed_html = "<p class='muted'>Throughput test skipped (--no-speed).</p>"

    bw = bw_summary(iface, days=7)
    bw_day = bw_summary(iface, days=1)
    bw_rates_7d = [d + u for _, d, u in bw_rates(iface, days=7)]
    mu, sigma, ng = gauss_fit(bw_rates_7d)
    bw_kpis = (
        f"<div class='grid'>"
        f"<div class='kpi'><div class='l'>24h down / up</div><div class='v mono' style='font-size:15px'>"
        f"{esc(fmt_bytes(bw_day['total_down']))} / {esc(fmt_bytes(bw_day['total_up']))}</div>"
        f"<div class='muted'>{bw_day['n']} intervals sampled</div></div>"
        f"<div class='kpi'><div class='l'>7d down / up</div><div class='v mono' style='font-size:15px'>"
        f"{esc(fmt_bytes(bw['total_down']))} / {esc(fmt_bytes(bw['total_up']))}</div>"
        f"<div class='muted'>avg {esc(fmt_bytes(bw['avg_down']))}/s down</div></div>"
        f"<div class='kpi'><div class='l'>Normal fit (hourly rate)</div><div class='v mono' "
        f"style='font-size:15px'>μ {esc(fmt_bytes(mu))}/s · σ {esc(fmt_bytes(sigma))}/s</div>"
        f"<div class='muted'>n={ng} hourly samples</div></div>"
        f"</div>")
    bw_bars_24 = svg_bars([(h[5:], v) for h, v in bw_day["hourly"]], unit="B")
    bw_bars_7d = svg_bars([(d[5:], v) for d, v in bw["daily"]], unit="B")
    bw_gauss = svg_gauss(bw_rates_7d, unit="B/s")

    def _failed(p):
        return p.get("loss") not in ("0%", "?")
    conn_name = dev_kv.get("GENERAL.CONNECTION", "") or "<profile>"
    hot = set()
    if _failed(pg):
        hot.update(("reconnect", "dhcp", "router"))
    if not _failed(pg) and _failed(pd):
        hot.update(("dns-flush", "dns-switch"))
    kit_rows = [
        ("radio", "Wi-Fi radio off / blocked", "nmcli radio wifi on && rfkill unblock wifi"),
        ("rescan", "AP missing from scan", f"nmcli device wifi list ifname {iface} --rescan yes"),
        ("reconnect", "Not associated / gateway down",
         f'nmcli connection down "{conn_name}" && nmcli connection up "{conn_name}"'),
        ("dhcp", "No valid lease (169.254.x.x)", f"nmcli device reapply {iface}"),
        ("dns-flush", "Stale DNS cache", "resolvectl flush-caches"),
        ("dns-switch", "DNS not resolving",
         f'nmcli connection modify "{conn_name}" ipv4.dns "1.1.1.1,8.8.8.8" '
         f'ipv4.ignore-auto-dns yes && nmcli connection up "{conn_name}"'),
        ("nm-restart", "Last resort (drops links ~10s)", "sudo systemctl restart NetworkManager"),
        ("router", "Gateway dead after reconnects", "unplug router 10 s → plug back → wait 2 min → re-scan"),
    ]
    kit_html = "".join(
        f"<tr><td>{'● ' if kid in hot else ''}{esc(when)}</td>"
        f"<td class='mono'>{esc(cmd)}</td></tr>"
        for kid, when, cmd in kit_rows)

    return f"""<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Wi-Fi Diagnostic Report — {esc(hostname)}</title>
<style>
:root{{--bg:#000000;--card:#fafafa;--muted:#5c5c5c;--line:#dcdcdc;--accent:#000000;--text:#111111}}
*{{box-sizing:border-box}}body{{margin:0;font-family:"Helvetica Neue",Helvetica,Arial,sans-serif;background:var(--bg);color:#f5f5f5;font-size:14px;line-height:1.45}}
header{{background:#000;color:#fff;padding:18px 22px;border-bottom:2px solid #fff}}
header h1{{margin:0 0 4px;font-size:20px;font-weight:700;letter-spacing:.02em}}header p{{margin:2px 0;opacity:.75;font-size:13px}}
header code{{color:#fff;background:#1c1c1c;padding:1px 5px;border-radius:4px}}
.wrap{{max-width:1100px;margin:-12px auto 32px;padding:0 16px}}
.card{{background:var(--card);color:var(--text);border:1px solid #fff;border-radius:10px;padding:14px 16px;margin:10px 0}}
.card h2{{margin:0 0 10px;font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;border-bottom:2px solid #111;padding-bottom:6px;color:#000}}
.card h3{{color:#111;font-size:13px;margin:10px 0 4px}}
.grid{{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px}}
.kpi{{background:#efefef;border:1px solid #d4d4d4;border-radius:8px;padding:10px 12px}}
.kpi .v{{font-size:18px;font-weight:700;color:#000}}.kpi .l{{color:#555;font-size:11px;text-transform:uppercase;letter-spacing:.06em}}
.dot{{display:inline-block;width:8px;height:8px;border-radius:50%;background:#000;margin-right:6px}}
table{{width:100%;border-collapse:collapse;font-size:13px}}th,td{{text-align:left;padding:6px 8px;border-bottom:1px solid #d4d4d4;vertical-align:top}}
th{{background:#111;position:sticky;top:0;color:#fff;font-weight:700;font-size:12px;text-transform:uppercase;letter-spacing:.04em}}tr.cur{{background:#e4e4e4}}
.muted{{color:var(--muted);font-size:12px}}.mono{{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px}}
code{{color:#111;background:#e8e8e8;padding:1px 5px;border-radius:4px}}
#nets td:first-child{{color:#000;font-size:11px}}
.sig{{height:6px;background:#d4d4d4;border-radius:99px;overflow:hidden;min-width:100px}}.sigfill{{height:100%}}
.hrow{{display:flex;align-items:center;gap:8px;margin:5px 0}}.hbar{{flex:1;height:10px;background:#d4d4d4;border-radius:99px;overflow:hidden}}.hfill{{height:100%;background:#000}}.sigfill2{{background:linear-gradient(90deg,#000,#666,#ccc)}}
.ch{{min-width:52px}}.ssid{{min-width:220px;max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}}
pre{{background:#000;color:#f0f0f0;padding:10px 12px;border-radius:8px;overflow:auto;font-size:12px;max-height:340px;border:1px solid #333}}
.badge{{display:inline-block;font-size:11px;font-weight:700;padding:2px 8px;border-radius:99px;background:#000;color:#fff;margin-right:6px;letter-spacing:.04em}}
li.good .badge{{background:#000;color:#fff}}li.warn .badge{{background:#fff;color:#000;border:1px solid #000}}li.bad .badge{{background:#fff;color:#000;border:2px solid #000}}li.info .badge{{background:#555;color:#fff}}
ul.recs{{list-style:none;padding:0;margin:0}}ul.recs li{{padding:8px 10px;border:1px solid #d4d4d4;border-radius:8px;margin:6px 0;background:#f4f4f4;color:#111}}
.toolbar{{display:flex;gap:8px;margin-bottom:8px}}input[type=search]{{flex:1;padding:7px 10px;border:1px solid #111;border-radius:6px;background:#fff;color:#111}}
footer{{color:#888;font-size:12px;text-align:center;margin:14px}}
@media print{{header{{-webkit-print-color-adjust:exact;print-color-adjust:exact}}.wrap{{margin:0;max-width:none}}}}
</style></head><body>
<header><h1>Wi-Fi Diagnostic Report</h1>
<p>Host <strong>{esc(hostname)}</strong> · Interface <strong>{esc(iface)}</strong> · Generated {esc(now_local.strftime("%Y-%m-%d %H:%M:%S %Z"))} ({esc(now_utc.strftime("%Y-%m-%d %H:%M UTC"))})</p>
<p>Connected to <strong>{cur_ssid}</strong> ({cur_bssid}) · {len(nets)} networks found · Linux equivalent of <code>netsh wlan show networks</code> + <code>netsh wlanreport</code></p></header>
<div class="wrap">
<div class="card"><h2>Summary</h2><div class="grid">
<div class="kpi"><div class="l">Status</div><div class="v"><span class="dot"></span>Connected</div><div class="muted">{cur_ssid} · {esc(gen_state)}</div></div>
<div class="kpi"><div class="l">Signal</div><div class="v">{cur_dbm if cur_dbm is not None else "?"} dBm</div><div class="muted">{sig_pct}% · {sig_qual}</div></div>
<div class="kpi"><div class="l">Link speed</div><div class="v mono" style="font-size:15px">{esc(rx_rate)}</div><div class="muted">RX · TX {esc(tx_rate)}</div></div>
<div class="kpi"><div class="l">Channel / Band</div><div class="v mono">ch {esc(cur_chan)}</div><div class="muted">{esc(cur_bandline)}</div></div>
<div class="kpi"><div class="l">Local IP / Gateway</div><div class="v mono" style="font-size:15px">{esc(local_ip)}</div><div class="muted mono">gw {esc(dev_kv.get("IP4.GATEWAY", "-"))} · ping {esc(pg["avg"])} ms</div></div>
<div class="kpi"><div class="l">Internet</div><div class="v">8.8.8.8 {esc(pe["avg"])} ms</div><div class="muted">loss {esc(pe["loss"])} · DNS google.com {esc(pd["avg"])} ms</div></div>
<div class="kpi"><div class="l">Networks nearby</div><div class="v">{len(nets)}</div><div class="muted">{esc(band_summary)}</div></div>
<div class="kpi"><div class="l">Adapter</div><div class="v" style="font-size:14px">{esc(product)}</div><div class="muted mono">{esc(driver)} · {esc(fw)}</div></div>
</div></div>
<div class="card"><h2>Recommendations</h2><ul class="recs">{rec_html}</ul></div>
<div class="card"><h2>Adapter &amp; System</h2>
<table><tr><th style="width:260px">Item</th><th>Value</th></tr>
<tr><td>Adapter</td><td>{esc(dev_kv.get("GENERAL.PRODUCT", "-"))} — {esc(dev_kv.get("GENERAL.VENDOR", ""))} <span class="muted">({esc(dev_kv.get("GENERAL.PATH", ""))})</span></td></tr>
<tr><td>Driver / Firmware</td><td class="mono">{esc(dev_kv.get("GENERAL.DRIVER", "-"))} · kernel {esc(dev_kv.get("GENERAL.DRIVER-VERSION", "-"))} · fw {esc(dev_kv.get("GENERAL.FIRMWARE-VERSION", "-"))}</td></tr>
<tr><td>MAC</td><td class="mono">{esc(dev_kv.get("GENERAL.HWADDR", "-"))}</td></tr>
<tr><td>MTU / State</td><td class="mono">{esc(dev_kv.get("GENERAL.MTU", "-"))} · {esc(dev_kv.get("GENERAL.STATE", "-"))}</td></tr>
<tr><td>lspci</td><td class="mono">{esc(lspci_line)}</td></tr>
<tr><td>Radio</td><td class="mono">{esc(radio)} · {esc(data["dev_status"].splitlines()[0] if data["dev_status"] else "")}</td></tr>
<tr><td>/proc/net/wireless</td><td class="mono">{esc(data["proc_wireless"].replace(chr(10), " | "))}</td></tr>
</table></div>
<div class="card"><h2>Current connection — {cur_ssid}</h2>
<table><tr><th style="width:260px">Item</th><th>Value</th></tr>
<tr><td>SSID / BSSID</td><td><strong>{cur_ssid}</strong> <span class="mono muted">{cur_bssid}</span></td></tr>
<tr><td>Frequency / Channel</td><td class="mono">{esc(freq_line)} · ch {esc(cur_chan)} · {esc(cur_bandline)}</td></tr>
<tr><td>Security</td><td>{esc(cur_sec)} <span class="muted mono">{esc(cur_sec_raw)}</span></td></tr>
<tr><td>Signal</td><td class="mono">{cur_dbm} dBm · {sig_pct}% · {sig_qual}</td></tr>
<tr><td>Bitrates</td><td class="mono">RX {esc(rx_rate)} <br>TX {esc(tx_rate)}</td></tr>
<tr><td>IPv4</td><td class="mono">{esc(dev_kv.get("IP4.ADDRESS[1]", "-"))} · gw {esc(dev_kv.get("IP4.GATEWAY", "-"))} · dns {esc(dev_kv.get("IP4.DNS[1]", "-"))}</td></tr>
<tr><td>IPv6</td><td class="mono">{esc(dev_kv.get("IP6.ADDRESS[1]", "-"))} · gw {esc(dev_kv.get("IP6.GATEWAY", "-"))}</td></tr>
<tr><td>Routes</td><td class="mono">{esc(data["ip_route"])}<br>{esc(data["ip6_route"])}</td></tr>
</table>
<h3 style="margin:10px 0 4px">iw link</h3><pre>{esc(iw_link)}</pre>
<h3 style="margin:10px 0 4px">iw station dump</h3><pre>{esc(data["iw_station"])}</pre>
</div>
<div class="card"><h2>All nearby networks ({len(nets)})</h2>
<div class="toolbar"><input type="search" id="q" placeholder="Filter by SSID / BSSID / channel / security…"></div>
<table id="nets"><thead><tr><th></th><th>Network (SSID / BSSID)</th><th>Ch</th><th>Freq / Band</th><th>Signal</th><th>Max rate</th><th>Security</th><th>Mode</th></tr></thead>
<tbody>{rows_html}</tbody></table>
