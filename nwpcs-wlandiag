def diagnose_for_fix(iface, log=None):
    """Fast offline-capable diagnosis. Returns (problems, suggested step ids, notes)."""
    problems, plan, notes = [], [], []
    out, _ = run(["nmcli", "radio", "wifi"], timeout=10)
    if out.strip() != "enabled":
        problems.append("Wi-Fi radio is off")
        plan.append("radio")
    if shutil.which("rfkill"):
        rk, _ = run(["rfkill", "list", "wifi"], timeout=10)
        if re.search(r"soft blocked:\s*yes|hard blocked:\s*yes", rk, re.I):
            problems.append("RF kill switch is blocking Wi-Fi")
            plan.append("rfkill")
    if not _iw_connected(iface):
        problems.append("not associated to any access point")
        plan += ["rescan", "reconnect"]
    else:
        ip4, _ = run(["nmcli", "-t", "-f", "IP4.ADDRESS", "device", "show", iface], timeout=10)
        if "169.254." in ip4 or "ADDRESS" not in ip4:
            problems.append("no valid DHCP lease")
            plan.append("dhcp")
        else:
            gw, _ = run(["nmcli", "-t", "-f", "IP4.GATEWAY", "device", "show", iface], timeout=10)
            gw = gw.split(":")[-1].strip() if ":" in gw else "192.168.1.1"
            gp, _ = run(["ping", "-c", "2", "-W", "2", gw], timeout=10)
            if "0 received" in gp or "100% packet loss" in gp:
                problems.append(f"gateway {gw} unreachable")
                plan.append("reconnect")
                notes.append("If the gateway stays unreachable: reboot your router "
                             "(unplug 10s), check its cables, then re-run.")
            else:
                ext, _ = run(["ping", "-c", "2", "-W", "2", "8.8.8.8"], timeout=10)
                dns, _ = run(["getent", "hosts", "google.com"], timeout=10)
                if ("0 received" in ext or "100% packet loss" in ext) and not dns.strip():
                    problems.append("internet unreachable beyond the router")
                    notes.append("Router is fine but upstream is down — likely your ISP. "
                                 "Check the router's WAN light, then call them with these symptoms.")
                elif not dns.strip():
                    problems.append("DNS not resolving (internet itself works)")
                    plan += ["dns-flush", "dns-switch"]
    if not problems:
        notes.append("Link looks healthy — if pages still fail, try `speed` to check throughput, "
                     "or look for congestion in the channel advisor.")
    seen, ordered = set(), []
    for step_id in plan:
        if step_id not in seen:
            seen.add(step_id)
            ordered.append(step_id)
    return problems, ordered, notes


def run_fix_plan(iface, step_ids, dry_run=False, auto_yes=False, log=None):
    results = []
    for st in FIX_STEPS:
        if st["id"] not in step_ids:
            continue
        if dry_run:
            results.append((st["id"], "dry-run", "would run: " + " && ".join(st["cmds"])))
            continue
        if st.get("confirm") and not auto_yes and not _confirm(f"Apply '{st['title']}'?"):
            results.append((st["id"], "skipped", "declined"))
            if log:
                log.say("sys", f"skipped '{st['id']}' (declined)")
            continue
        try:
            status, detail = st["fn"](iface, log)
        except Exception as e:  # noqa: BLE001
            status, detail = "failed", f"{type(e).__name__}: {e}"
        results.append((st["id"], status, detail))
        if log:
            mark = {"fixed": "ok", "ok": "ok", "failed": "err", "skipped": "sys"}.get(status, "sys")
            log.say(mark, f"[{st['id']}] {status}: {detail}")
    return results


def verify_link_quick(iface):
    """One-line verdict after fixes: (ok: bool, summary: str)."""
    if not _iw_connected(iface):
        return False, "still not associated to any AP"
    gw_out, _ = run(["nmcli", "-t", "-f", "IP4.GATEWAY", "device", "show", iface], timeout=10)
    gw = gw_out.split(":")[-1].strip() if ":" in gw_out else ""
    if not gw or gw == "--":
        return False, "associated but no gateway"
    gp, _ = run(["ping", "-c", "2", "-W", "2", gw], timeout=10)
    if "0 received" in gp or "100% packet loss" in gp:
        return False, f"associated but gateway {gw} unreachable"
    dns, _ = run(["getent", "hosts", "google.com"], timeout=10)
    if not dns.strip():
        return False, "gateway OK but DNS not resolving"
    return True, f"link works (gw {gw}, DNS resolving)"

