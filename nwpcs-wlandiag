def data_dir():
    """Organized home for all tool outputs (XDG_DATA_HOME aware).

    Everything the tool writes — reports, JSON sidecars, chat transcripts —
    lives here instead of being scattered across $HOME.
    """
    base = os.environ.get("XDG_DATA_HOME") or str(pathlib.Path.home() / ".local" / "share")
    return pathlib.Path(base) / "nwpcs-wlandiag"


DEFAULT_OUT = str(data_dir() / "nwpcs-wlandiag.html")
HISTORY_DB = str(data_dir() / "history.db")
HISTORY_KEEP_DAYS = 30


# ------------------------------------------------- scan history (sqlite)

def _history_conn():
    data_dir().mkdir(parents=True, exist_ok=True)
    cx = sqlite3.connect(HISTORY_DB)
    cx.execute("CREATE TABLE IF NOT EXISTS ap_scan(ts INTEGER, iface TEXT, ssid TEXT,"
               " bssid TEXT, chan TEXT, freq_mhz INTEGER, signal INTEGER, security TEXT, band TEXT)")
    cx.execute("CREATE TABLE IF NOT EXISTS link(ts INTEGER, iface TEXT, ssid TEXT, bssid TEXT,"
               " dbm INTEGER, ping_gw REAL, ping_ext REAL)")
    cx.execute("CREATE INDEX IF NOT EXISTS idx_ap_ts ON ap_scan(ts)")
    cx.execute("CREATE INDEX IF NOT EXISTS idx_link_ts ON link(ts)")
    cx.execute("CREATE TABLE IF NOT EXISTS bw(ts INTEGER, iface TEXT, rx_bytes INTEGER,"
               " tx_bytes INTEGER)")
    cx.execute("CREATE INDEX IF NOT EXISTS idx_bw_ts ON bw(ts)")
    return cx


# ------------------------------------------------- bandwidth workload

def read_counters(iface):
    """Kernel byte counters for an interface. Returns (rx, tx) or None."""
    try:
        base = pathlib.Path("/sys/class/net") / iface / "statistics"
        rx = int((base / "rx_bytes").read_text().strip())
        tx = int((base / "tx_bytes").read_text().strip())
        return rx, tx
    except Exception:  # noqa: BLE001 no such iface / no permission
        return None


def record_bw(iface):
    """Append one counter sample. Never raises."""
    try:
        c = read_counters(iface)
        if c is None:
            return False
        cx = _history_conn()
        cx.execute("INSERT INTO bw VALUES (?,?,?,?)", (int(time.time()), iface, c[0], c[1]))
        cutoff = int(time.time()) - 30 * 86400
        cx.execute("DELETE FROM bw WHERE ts < ?", (cutoff,))
        cx.commit()
        cx.close()
        return True
    except Exception:  # noqa: BLE001
        return False


def bw_rates(iface, days=7):
    """Per-interval byte rates from consecutive samples: [(ts, down_Bps, up_Bps)]."""
    try:
        cx = _history_conn()
        since = int(time.time()) - days * 86400
        rows = cx.execute("SELECT ts, rx_bytes, tx_bytes FROM bw WHERE iface=? AND ts>=? "
                          "ORDER BY ts", (iface, since)).fetchall()
        cx.close()
    except Exception:  # noqa: BLE001
        return []
    out = []
    for (t1, rx1, tx1), (t2, rx2, tx2) in zip(rows, rows[1:]):
        dt = t2 - t1
        dr, du = rx2 - rx1, tx2 - tx1
        if dt <= 0 or dr < 0 or du < 0:  # counter reset / reboot
            continue
        out.append((t2, dr / dt, du / dt))
    return out


def fmt_bytes(n):
    n = float(n or 0)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} TB"


def bw_summary(iface, days=7):
    """Totals, peaks and hourly/daily buckets. All rates are bytes/sec."""
    rates = bw_rates(iface, days)
    s = {"n": len(rates), "iface": iface, "days": days, "total_down": 0.0, "total_up": 0.0,
         "avg_down": 0.0, "avg_up": 0.0, "peak_down": 0.0, "peak_up": 0.0,
         "peak_ts": None, "hourly": [], "daily": []}
    if not rates:
        return s
    tot_d = tot_u = 0.0
    hours, daysum = {}, {}
    peak, peak_ts = 0.0, None
    gaps = [rates[i + 1][0] - r[0] for i, r in enumerate(rates[:-1])]
    last_dt = sorted(gaps)[len(gaps) // 2] if gaps else 0
    for i, (t, d, u) in enumerate(rates):
        dt = (rates[i + 1][0] - t) if i + 1 < len(rates) else last_dt
        tot_d += d * dt
        tot_u += u * dt
        h = datetime.datetime.fromtimestamp(t).strftime("%Y-%m-%d %H:00")
        hours[h] = hours.get(h, [0.0, 0])
        hours[h][0] += d * dt
        hours[h][1] += 1
        dy = datetime.datetime.fromtimestamp(t).strftime("%Y-%m-%d")
        daysum[dy] = daysum.get(dy, 0.0) + (d + u) * dt
        if d + u > peak:
            peak, peak_ts = d + u, t
    span = max(r[0] for r in rates) - min(r[0] for r in rates)
    s.update(total_down=tot_d, total_up=tot_u,
             avg_down=tot_d / span if span else 0, avg_up=tot_u / span if span else 0,
             peak_down=peak, peak_ts=peak_ts,
             hourly=sorted((h, v[0]) for h, v in hours.items()),
             daily=sorted(daysum.items()))
    return s


def gauss_fit(vals):
    """Mean/stddev of samples. Returns (mu, sigma, n) or (0,0,0)."""
    vals = [float(v) for v in vals if v is not None]
    if len(vals) < 5:
        return 0.0, 0.0, len(vals)
    mu = statistics.fmean(vals)
    sigma = statistics.pstdev(vals) if len(vals) > 1 else 0.0
    return mu, sigma, len(vals)


def svg_bars(pairs, width=560, height=130, unit=""):
    """Vertical bar chart. pairs: [(label, value)]. Grayscale."""
    esc = html.escape
    if not pairs:
        return '<p class="muted">No samples in this window yet.</p>'
    mx = max(v for _, v in pairs) or 1
    n = len(pairs)
    bw = min(34, (width - 40) / max(n, 1) - 4)
    parts = [f'<svg viewBox="0 0 {width} {height}" style="width:100%;height:auto" role="img">']
    for i, (label, v) in enumerate(pairs):
        h = max(2, (v / mx) * (height - 34))
        x = 34 + i * ((width - 40) / n)
        y = height - 20 - h
        parts.append(f'<rect x="{x:.1f}" y="{y:.1f}" width="{bw:.1f}" height="{h:.1f}" fill="#000"/>'
                     f'<title>{esc(label)}: {esc(unit)}{v:,.0f}</title>')
    every = max(1, n // 8)
    for i, (label, _) in enumerate(pairs):
        if i % every == 0:
            x = 34 + i * ((width - 40) / n)
            parts.append(f'<text x="{x:.1f}" y="{height - 6}" font-size="9" fill="#5c5c5c">'
                         f'{esc(label[-5:])}</text>')
    parts.append(f'<text x="2" y="12" font-size="10" fill="#5c5c5c">{esc(unit)}{mx:,.0f}</text></svg>')
    return "".join(parts)


def svg_gauss(vals, width=560, height=170, unit="B/s"):
    """Histogram + fitted normal curve (grayscale)."""
    esc = html.escape
    vals = [float(v) for v in vals if v is not None]
    if len(vals) < 5:
        return '<p class="muted">Not enough samples yet for a distribution (need 5+).</p>'
    mu, sigma, n = gauss_fit(vals)
    if sigma <= 0:
        return (f'<p class="muted">All {n} samples identical '
                f'({esc(unit)} {mu:,.0f}) — perfectly flat workload.</p>')
    lo, hi = min(vals), max(vals)
    span = (hi - lo) or 1.0
    lo -= span * 0.05
    hi += span * 0.05
    nbins = min(12, max(5, n // 4))
    bins = [0] * nbins
    for v in vals:
        b = min(nbins - 1, int((v - lo) / (hi - lo) * nbins))
        bins[b] += 1
    pad_l, pad_b, pad_t = 44, 20, 10
    iw, ih = width - pad_l - 10, height - pad_t - pad_b
    bmax = max(bins)
    parts = [f'<svg viewBox="0 0 {width} {height}" style="width:100%;height:auto" role="img">']
    bw = iw / nbins
    for i, c in enumerate(bins):
        h = (c / bmax) * ih * 0.92
        x = pad_l + i * bw + 1
        parts.append(f'<rect x="{x:.1f}" y="{pad_t + ih - h:.1f}" width="{bw - 2:.1f}" '
                     f'height="{h:.1f}" fill="#d4d4d4"/>')
    peak = 1 / (sigma * math.sqrt(2 * math.pi))
    pts = []
    for j in range(61):
        x = lo + (hi - lo) * j / 60
        dens = math.exp(-((x - mu) ** 2) / (2 * sigma ** 2)) / (sigma * math.sqrt(2 * math.pi))
        px = pad_l + (x - lo) / (hi - lo) * iw
        py = pad_t + ih - (dens / peak) * ih * 0.92
        pts.append(f"{px:.1f},{py:.1f}")
    parts.append(f'<polyline points="{" ".join(pts)}" fill="none" stroke="#000" stroke-width="2"/>')
    for k, lab in ((-1, "μ−σ"), (0, "μ"), (1, "μ+σ")):
        xv = mu + k * sigma
        if lo <= xv <= hi:
            px = pad_l + (xv - lo) / (hi - lo) * iw
            dash = ' stroke-dasharray="3,3"' if k else ""
            parts.append(f'<line x1="{px:.1f}" y1="{pad_t}" x2="{px:.1f}" y2="{pad_t + ih}" '
                         f'stroke="#555" stroke-width="1"{dash}/>'
                         f'<text x="{px + 2:.1f}" y="{pad_t + 10}" font-size="9" fill="#555">{lab}</text>')
    parts.append(f'<text x="{pad_l}" y="{height - 5}" font-size="10" fill="#5c5c5c">'
                 f'n={n} μ={mu:,.0f} σ={sigma:,.0f} {esc(unit)}</text></svg>')
    return "".join(parts)


def record_history(nets, iface, cur_ssid="", cur_bssid="", dbm=None, ping_gw=None, ping_ext=None):
    """Append one scan snapshot. Never raises — history must not break diagnosis."""
    try:
        cx = _history_conn()
        now = int(time.time())
        for n in nets:
            cx.execute("INSERT INTO ap_scan VALUES (?,?,?,?,?,?,?,?,?)",
                       (now, iface, n.get("SSID", ""), n.get("BSSID", ""), n.get("CHAN", ""),
                        n.get("FREQ_MHZ", 0), n.get("SIGNAL_INT", -1), n.get("SECURITY", ""),
                        n.get("BAND", "")))
        if cur_ssid:
            try:
                gw = float((ping_gw or {}).get("avg", 0)) or None
            except (TypeError, ValueError):
                gw = None
            try:
                ext = float((ping_ext or {}).get("avg", 0)) or None
            except (TypeError, ValueError):
                ext = None
            cx.execute("INSERT INTO link VALUES (?,?,?,?,?,?,?)",
                       (now, iface, cur_ssid, cur_bssid, dbm, gw, ext))
        cutoff = now - HISTORY_KEEP_DAYS * 86400
        cx.execute("DELETE FROM ap_scan WHERE ts < ?", (cutoff,))
        cx.execute("DELETE FROM link WHERE ts < ?", (cutoff,))
        cx.commit()
        cx.close()
    except Exception:  # noqa: BLE001
        pass


def read_history(limit=50, days=7):
    """Return {'link': [...], 'aps': {ssid: [(ts, signal)]}}. Newest-first link rows."""
    out = {"link": [], "aps": {}}
    try:
        cx = _history_conn()
        since = int(time.time()) - days * 86400
        for row in cx.execute("SELECT ts, iface, ssid, bssid, dbm, ping_gw, ping_ext FROM link"
                              " WHERE ts >= ? ORDER BY ts DESC LIMIT ?", (since, limit)):
            out["link"].append({"ts": row[0], "iface": row[1], "ssid": row[2], "bssid": row[3],
                                "dbm": row[4], "ping_gw": row[5], "ping_ext": row[6]})
        for ssid, ts, sig in cx.execute("SELECT ssid, ts, signal FROM ap_scan WHERE ts >= ?"
                                        " AND ssid != '' ORDER BY ts", (since,)):
            out["aps"].setdefault(ssid if ssid else "(hidden)", []).append((ts, sig))
        cx.close()
    except Exception:  # noqa: BLE001
        pass
    return out


def clear_history():
    try:
        cx = _history_conn()
        cx.execute("DELETE FROM ap_scan")
        cx.execute("DELETE FROM link")
        cx.commit()
        cx.close()
        return True
    except Exception:  # noqa: BLE001
        return False


