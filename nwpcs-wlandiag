def print_bw(s):
    print(f"Bandwidth workload — {s['iface']} (last {s['days']}d, {s['n']} intervals)")
    if not s["n"]:
        print("No samples yet. Run any scan/info/report, `bw sample`, or add a cron job:")
        print("  * * * * * nwpcs-wlandiag bw sample >/dev/null 2>&1")
        return
    print(f"Down {fmt_bytes(s['total_down'])}   Up {fmt_bytes(s['total_up'])}   "
          f"Avg {fmt_bytes(s['avg_down'])}/s down / {fmt_bytes(s['avg_up'])}/s up")
    if s["peak_ts"]:
        ts = datetime.datetime.fromtimestamp(s["peak_ts"]).strftime("%m-%d %H:%M")
        print(f"Peak {fmt_bytes(s['peak_down'])}/s combined at {ts}")
    if s["daily"]:
        print("Per day (up+down):")
        for day, total in s["daily"][-7:]:
            print(f"  {day}  {fmt_bytes(total)}")


def print_scan_table(nets, limit=0, sort="signal"):
    if sort == "channel":
        nets = sorted(nets, key=lambda n: (n.get("CHAN_INT", 999) if isinstance(n.get("CHAN_INT"), int) else 9999, -n["SIGNAL_INT"]))
    elif sort == "ssid":
        nets = sorted(nets, key=lambda n: ((n["SSID"] or "\uffff").lower(), -n["SIGNAL_INT"]))
    else:
        nets = sorted(nets, key=lambda n: n["SIGNAL_INT"], reverse=True)
    if limit and limit > 0:
        nets = nets[:limit]
    hdr = f'{"*":1} {"SSID":28} {"BSSID":17} {"CH":>3} {"FREQ":>10} {"SIG":>4}  SECURITY'
    print(hdr)
    print("-" * len(hdr))
    for n in nets:
        star = "*" if n.get("IN-USE") == "*" else " "
        ssid = (n["SSID_DISP"] or "")[:28]
        print(f"{star} {ssid:28} {n['BSSID']:17} {n['CHAN']:>3} {n['FREQ']:>10} {n['SIGNAL_INT']:>3}%  {n['SECURITY']}")
    print(f"\n{len(nets)} network(s) shown.")


def print_info(data):
    dev_kv = data["dev_kv"]
    nets = data["nets"]
    cur = next((n for n in nets if n.get("IN-USE") == "*"), None)
    m = re.search(r"signal:\s*(-?\d+)\s*dBm", data["iw_link"])
    dbm = m.group(1) + " dBm" if m else "?"
    print(f"Interface : {data['iface']}")
    print(f"Adapter   : {dev_kv.get('GENERAL.PRODUCT', '-')} ({dev_kv.get('GENERAL.DRIVER', '-')})")
    print(f"Connected : {cur['SSID'] + ' / ' + cur['BSSID'] if cur else '(disconnected)'}")
    print(f"Signal    : {dbm} ({cur['SIGNAL_INT']}% {quality_label(cur['SIGNAL_INT'])})" if cur else "Signal    : -")
    print(f"Channel   : {cur['CHAN'] + ' / ' + cur['FREQ'] + ' / ' + cur['BAND'] if cur else '-'}")
    print(f"Security  : {sec_label(cur['SECURITY']) if cur else '-'}")
    print(f"IPv4      : {dev_kv.get('IP4.ADDRESS[1]', '-')}  gw {dev_kv.get('IP4.GATEWAY', '-')}")
    print(f"Ping gw   : {data['ping_gw']['avg']} ms (loss {data['ping_gw']['loss']})")
    print(f"Ping inet : {data['ping_ext']['avg']} ms to 8.8.8.8 (loss {data['ping_ext']['loss']})")
    print(f"Nearby    : {len(nets)} network(s)")
    sp = data.get("speed", {}) or {}
    if "mbps" in sp:
        print(f"Throughput: {sp['mbps']} Mbps down ({sp['bytes'] // 1_000_000} MB in {sp['seconds']}s)")
    adv = advise_channels(nets)
    for band in ("2.4 GHz", "5 GHz"):
        if adv.get(band):
            best = adv[band][0]
            print(f"Best {band:7}: ch {best['chan']} (score {best['score']:.0f}/100)")
    worst = [f for f in audit_security(nets) if f[0] in ("crit", "high")]
    if worst:
        print(f"Security  : {len(worst)} warning(s) — worst: {worst[0][1]}")
    else:
        print("Security  : no warnings in this scan")
    bw1 = bw_summary(data["iface"], days=1)
    if bw1["n"]:
        print(f"Bandwidth : 24h {fmt_bytes(bw1['total_down'])} down / "
              f"{fmt_bytes(bw1['total_up'])} up ({bw1['n']} samples)")


def open_in_browser(path_or_url):
    """Open a file:// or http(s) URL in the user's browser.

    Tries Python's webbrowser module first, then desktop helpers
    (xdg-open, gio, ...). Returns True if something was launched.
    Never raises — callers print the URL for manual opening on False.
    """
    try:
        if webbrowser.open(path_or_url):
            return True
    except Exception:  # noqa: BLE001
        pass
    for helper in ("xdg-open", "gio", "gnome-open", "kde-open",
                   "sensible-browser", "wslview"):
        if not shutil.which(helper):
            continue
        try:
            if helper == "gio":
                r = subprocess.run(["gio", "open", path_or_url],
                                   capture_output=True, timeout=15)
            else:
                r = subprocess.run([helper, path_or_url],
                                   capture_output=True, timeout=15)
            if r.returncode == 0:
                return True
        except Exception:  # noqa: BLE001
            continue
    return False


def serve_file(path, bind="127.0.0.1", port=8000, open_browser=False):
    path = pathlib.Path(path).resolve()
    if not path.exists():
        print(f"error: file not found: {path}", file=sys.stderr)
        sys.exit(1)
    handler = functools.partial(http.server.SimpleHTTPRequestHandler, directory=str(path.parent))
    srv = http.server.ThreadingHTTPServer((bind, port), handler)
    url = f"http://{bind}:{srv.server_port}/{path.name}"
    print(f"Serving {path.parent} at http://{bind}:{srv.server_port}/")
    print(f"Report URL: {url}")
    if open_browser:
        threading.Timer(0.5, lambda: open_in_browser(url)).start()
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\nStopped.")
    finally:
        srv.server_close()


